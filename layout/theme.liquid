<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Load Tailwind CSS %}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # GSAP + ScrollTrigger for theme animations (self-hosted, deferred) %}
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'scrolltrigger.min.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body
    class="page-grid-bg"
  >
    <div class="page-transition" data-page-transition aria-hidden="true"></div>

    <script>
      /* Runs immediately (not deferred) so the fade clears as soon as
         possible after paint, and so link clicks are intercepted before
         the browser can navigate away. Kept short on purpose — pages
         have their own entrance animations, and a long transition here
         would eat into (or hide) those. */
      (function () {
        var overlay = document.querySelector('[data-page-transition]');
        if (!overlay) return;

        var CLOSE_DURATION = 200;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function open() {
          if (reduceMotion) {
            overlay.classList.add('page-transition--open');
            return;
          }
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              overlay.classList.add('page-transition--open');
            });
          });
        }

        function close(callback) {
          if (reduceMotion) {
            callback();
            return;
          }
          overlay.classList.remove('page-transition--open');
          setTimeout(callback, CLOSE_DURATION);
        }

        open();

        /* Pages restored from the back/forward cache skip reloading
           scripts, so the overlay would otherwise stay in whatever
           state it was left in when the user navigated away. */
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) open();
        });

        document.addEventListener('click', function (event) {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          var link = event.target.closest('a[href]');
          if (!link) return;
          if (link.target && link.target !== '_self') return;
          if (link.hasAttribute('download')) return;

          var url;
          try {
            url = new URL(link.href, window.location.href);
          } catch (e) {
            return;
          }

          if (url.origin !== window.location.origin) return;

          var isSamePageAnchor = url.pathname === window.location.pathname
            && url.search === window.location.search
            && url.hash !== '';
          if (isSamePageAnchor) return;

          event.preventDefault();
          close(function () {
            window.location.href = url.href;
          });
        });
      })();
    </script>

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    <script>
      /* Shared animation helpers. Section scripts wait for GSAP via
         ArthehopeAnims.whenGsap(), so load order vs. the deferred
         CDN above (or a blocked CDN) never breaks the page. */
      window.ArthehopeAnims = (function () {
        function prefersReduced() {
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        function whenGsap(callback, timeout) {
          timeout = timeout || 6000;
          if (window.gsap) {
            callback();
            return;
          }
          var waited = 0;
          var timer = setInterval(function () {
            waited += 50;
            if (window.gsap) {
              clearInterval(timer);
              callback();
            } else if (waited >= timeout) {
              clearInterval(timer);
            }
          }, 50);
        }

        /* Wraps each word in a mask so headings can rise up line by line.
           Uses textContent only, so merchant input stays escaped. */
        function splitWords(el) {
          if (!el || el.dataset.wordsSplit === 'true') return [];
          var text = el.textContent.trim().replace(/\s+/g, ' ');
          if (!text) return [];
          el.setAttribute('aria-label', text);
          el.innerHTML = text
            .split(' ')
            .map(function (w) {
              return '<span class="inline-block overflow-hidden align-bottom"><span class="inline-block" data-word>' + w + '</span></span>';
            })
            .join(' ');
          el.dataset.wordsSplit = 'true';
          return el.querySelectorAll('[data-word]');
        }

        /* Magnetic pull on hover for CTA buttons (fine pointers only).
           Auto-initialises every [data-magnetic] element on the page. */
        var magneticStrength = 8;
        function magnetic(selector, strength) {
          if (prefersReduced() || !window.gsap || window.matchMedia('(hover: none)').matches) return;
          strength = strength || magneticStrength;
          document.querySelectorAll(selector).forEach(function (el) {
            if (el._magneticInit) return;
            el._magneticInit = true;
            el.addEventListener('mousemove', function (e) {
              var r = el.getBoundingClientRect();
              window.gsap.to(el, {
                x: ((e.clientX - r.left - r.width / 2) / (r.width / 2)) * strength,
                y: ((e.clientY - r.top - r.height / 2) / (r.height / 2)) * strength,
                duration: 0.3,
                ease: 'power2.out',
                overwrite: 'auto'
              });
            });
            el.addEventListener('mouseleave', function () {
              window.gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.4)', overwrite: 'auto' });
            });
          });
        }

        function registerScrollTrigger() {
          if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);
        }

        document.addEventListener('shopify:section:load', function () {
          if (window.ScrollTrigger) window.ScrollTrigger.refresh();
          magnetic('[data-magnetic]');
        });

        /* Auto-init magnetic on all [data-magnetic] elements. */
        whenGsap(function () { magnetic('[data-magnetic]'); });

        return {
          prefersReduced: prefersReduced,
          whenGsap: whenGsap,
          splitWords: splitWords,
          magnetic: magnetic,
          registerScrollTrigger: registerScrollTrigger
        };
      })();
    </script>
  </body>
</html>
