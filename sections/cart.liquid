{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="full-width w-full">
  <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
    <div class="bg-white border-2 border-foreground rounded-md p-8 md:p-12">

      <div class="text-center mb-12 md:mb-16">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h1 class="font-primary m-0 text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.05] uppercase">
            {{ section.settings.heading }}
          </h1>
        {% endif %}
      </div>

      {% if cart.item_count == 0 %}
        <div class="text-center py-8">
          <h2 class="font-primary m-0 text-xl font-bold uppercase">{{ 'cart.empty_heading' | t }}</h2>
          <p class="mt-3 text-base text-muted max-w-[40ch] mx-auto">{{ 'cart.empty_description' | t }}</p>
          <a
            href="{{ section.settings.continue_shopping_url | default: "/pages/service"}}"
            data-magnetic
            class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 mt-8 no-underline"
          >
            <span class="hover-rollup leading-[1.3] h-[1.3em]">
              <span class="hover-rollup__item">{{ 'cart.continue_shopping' | t }}</span>
              <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ 'cart.continue_shopping' | t }}</span>
            </span>
            <span class="inline-flex shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        </div>
      {% else %}
        <form action="{{ routes.cart_url }}" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start" data-cart-form>
          <div class="lg:col-span-2 flex flex-col gap-4">
            {% for item in cart.items %}
              <div class="flex gap-4 border-2 border-foreground rounded-md p-4 bg-background max-sm:flex-col">
                <div class="w-24 h-24 shrink-0 rounded-md border-2 border-foreground overflow-hidden bg-white max-sm:w-full max-sm:h-40">
                  {% if item.image %}
                    {{
                      item.image
                      | image_url: width: 200, height: 200, crop: 'center'
                      | image_tag: class: 'block w-full h-full object-cover', loading: 'lazy'
                    }}
                  {% endif %}
                </div>

                <div class="flex-1 min-w-0 flex flex-col gap-2">
                  <div class="flex items-start justify-between gap-4">
                    <a href="{{ item.url }}" class="font-primary font-bold uppercase text-sm text-foreground no-underline">{{ item.product.title }}</a>
                    <span class="font-primary font-bold text-sm text-foreground shrink-0">{{ item.final_line_price | money }}</span>
                  </div>

                  {% unless item.product.has_only_default_variant %}
                    <p class="m-0 text-xs text-muted">{{ item.variant.title }}</p>
                  {% endunless %}

                  <div class="flex items-center justify-between gap-4 mt-2">
                    <input
                      type="number"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="{{ 'cart.quantity' | t }}"
                      data-cart-qty
                      class="w-20 rounded-md border-2 border-foreground bg-white px-3 py-2 text-sm text-foreground"
                    >
                    <a href="{{ item.url_to_remove }}" class="font-primary text-xs font-bold uppercase text-accent no-underline">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>
              </div>
            {% endfor %}

          </div>

          <div class="border-2 border-foreground rounded-md p-6 bg-background flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <span class="font-primary font-bold uppercase text-sm text-foreground">{{ 'cart.subtotal' | t }}</span>
              <span class="font-primary font-bold text-lg text-foreground">{{ cart.total_price | money }}</span>
            </div>
            <p class="m-0 text-xs text-muted">{{ 'cart.taxes_note' | t }}</p>

            <button
              type="submit"
              name="checkout"
              class="font-primary inline-flex items-center justify-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 mt-2 cursor-pointer"
            >
              {{ 'cart.checkout' | t }}
            </button>
          </div>
        </form>
      {% endif %}

    </div>
  </div>
</div>

{% javascript %}
  (function () {
    var form = document.querySelector('[data-cart-form]');
    if (!form) return;

    var qtyInputs = form.querySelectorAll('[data-cart-qty]');
    var updateTimeout;

    qtyInputs.forEach(function (input) {
      input.addEventListener('change', function () {
        clearTimeout(updateTimeout);
        submitCartUpdate();
      });

      input.addEventListener('input', function () {
        clearTimeout(updateTimeout);
        updateTimeout = setTimeout(function () {
          submitCartUpdate();
        }, 800);
      });
    });

    function submitCartUpdate() {
      var submitBtn = document.createElement('input');
      submitBtn.type = 'submit';
      submitBtn.name = 'update';
      submitBtn.style.display = 'none';
      form.appendChild(submitBtn);
      submitBtn.click();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your cart"
    },
    {
      "type": "url",
      "id": "continue_shopping_url",
      "label": "Continue shopping URL"
    }
  ]
}
{% endschema %}
