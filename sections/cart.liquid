{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="full-width w-full">
  <div class="max-w-[1400px] mx-auto mt-4 px-6 py-16 md:py-24">
    <div class="card-bg-hero border-2 border-foreground rounded-md p-8 md:p-12 card-shadow">

      <div class="mb-8 md:mb-10 flex items-end justify-between gap-6">
        <div>
          {% render 'badge', text: section.settings.badge_text %}

          {% if section.settings.heading != blank %}
            <h1 class="font-primary m-0 text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.05] uppercase">
              {{ section.settings.heading }} ({{ cart.item_count }})
            </h1>
          {% endif %}
        </div>

        {% if cart.item_count > 0 %}
          <a
            href="{{ section.settings.continue_shopping_url | default: '/pages/service' }}"
            class="shrink-0 text-sm text-muted underline underline-offset-4 hover:text-foreground"
          >
            {{ 'cart.continue_shopping' | t }}
          </a>
        {% endif %}
      </div>

      {% if cart.item_count == 0 %}
        <div class="text-center py-8">
          <h2 class="font-primary m-0 text-xl font-bold uppercase">{{ 'cart.empty_heading' | t }}</h2>
          <p class="mt-3 text-base text-muted max-w-[40ch] mx-auto">{{ 'cart.empty_description' | t }}</p>
          <a
            href="{{ section.settings.continue_shopping_url | default: "/pages/service"}}"
            data-magnetic
            class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 mt-8 no-underline"
          >
            <span class="hover-rollup leading-[1.3] h-[1.3em]">
              <span class="hover-rollup__item">{{ 'cart.continue_shopping' | t }}</span>
              <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ 'cart.continue_shopping' | t }}</span>
            </span>
            <span class="inline-flex shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        </div>
      {% else %}
        <form action="{{ routes.cart_url }}" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start" data-cart-form data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}">
          <div class="lg:col-span-2 min-w-0">
            <div class="hidden md:grid md:grid-cols-[minmax(0,1.3fr)_minmax(0,0.5fr)_minmax(0,1fr)_minmax(0,0.5fr)] md:items-center md:gap-4 pb-3 border-b-2 border-foreground/10 text-xs font-bold uppercase tracking-wide text-muted">
              <span>{{ 'cart.column_product' | t }}</span>
              <span>{{ 'cart.column_price' | t }}</span>
              <span>{{ 'cart.column_quantity' | t }}</span>
              <span class="md:text-right">{{ 'cart.column_total' | t }}</span>
            </div>

            {% for item in cart.items %}
              {% assign item_ratio = item.image.aspect_ratio | default: 1.0 %}
              <div class="grid gap-4 py-6 border-b-2 border-foreground/10 md:grid-cols-[minmax(0,1.3fr)_minmax(0,0.5fr)_minmax(0,1fr)_minmax(0,0.5fr)] md:items-center md:gap-4" data-cart-item="{{ item.key }}">
                <div class="flex gap-4 min-w-0">
                  <div
                    class="w-24 shrink-0 self-start rounded-md border border-foreground overflow-hidden card-bg-hero card-shadow"
                    style="aspect-ratio: {{ item_ratio }};"
                    data-cart-image
                  >
                    {% if item.image %}
                      {{
                        item.image
                        | image_url: width: 400
                        | image_tag: class: 'block w-full h-full object-cover', loading: 'lazy', alt: item.product.title
                      }}
                    {% endif %}
                  </div>

                  <div class="flex-1 min-w-0 flex flex-col gap-1">
                    <a href="{{ item.url }}" class="font-primary font-bold uppercase text-base text-foreground no-underline leading-snug">{{ item.product.title }}</a>
                    {% if item.options_with_values.size > 0 %}
                      {% for opt in item.options_with_values %}
                        <p class="m-0 text-xs">
                          <span class="text-muted">{{ opt.name }}:</span>
                          <span class="text-foreground font-bold">{{ opt.value }}</span>
                        </p>
                      {% endfor %}
                    {% elsif item.product.has_only_default_variant == false %}
                      <p class="m-0 text-xs text-muted">{{ item.variant.title }}</p>
                    {% endif %}
                    <p class="m-0 mt-1 text-sm font-bold text-foreground md:hidden">
                      {% if item.original_price > item.final_price %}
                        <span class="line-through text-muted font-normal">{{ item.original_price | money }}</span>
                      {% endif %}
                      {{ item.final_price | money }}
                    </p>
                  </div>
                </div>

                <div class="hidden md:block text-sm font-bold text-foreground">
                  {% if item.original_price > item.final_price %}
                    <span class="block line-through text-muted font-normal">{{ item.original_price | money }}</span>
                  {% endif %}
                  {{ item.final_price | money }}
                </div>

                <div class="flex items-center gap-3">
                  <div class="inline-flex items-center gap-1 rounded-pill border-2 border-foreground bg-background px-2 py-1 max-md:px-1.5 max-md:py-0.5" data-qty-control data-item-key="{{ item.key }}">
                    <button
                      type="button"
                      data-qty-minus
                      aria-label="{{ 'cart.decrease_quantity' | t }}"
                      class="inline-flex h-8 w-8 max-md:h-7 max-md:w-7 items-center justify-center rounded-full bg-transparent border-0 text-foreground cursor-pointer transition-opacity hover:opacity-60 disabled:opacity-30 disabled:cursor-not-allowed"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </button>
                    <span class="text-xs font-bold uppercase tracking-wide text-muted">{{ 'cart.qty' | t }}:</span>
                    <input
                      type="number"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="{{ 'cart.quantity' | t }}"
                      data-cart-qty
                      class="w-10 max-md:w-8 bg-transparent border-0 p-0 text-center text-sm max-md:text-xs font-bold text-foreground disabled:opacity-40"
                    >
                    <button
                      type="button"
                      data-qty-plus
                      aria-label="{{ 'cart.increase_quantity' | t }}"
                      class="inline-flex h-8 w-8 max-md:h-7 max-md:w-7 items-center justify-center rounded-full bg-transparent border-0 text-foreground cursor-pointer transition-opacity hover:opacity-60 disabled:opacity-30 disabled:cursor-not-allowed"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </button>
                  </div>
                  <button
                    type="button"
                    data-qty-remove
                    aria-label="{{ 'cart.remove' | t }}"
                    class="inline-flex h-8 w-8 items-center justify-center bg-transparent border-0 text-accent cursor-pointer transition-opacity hover:opacity-60"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="3 6 5 6 21 6"/>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                  </button>
                </div>

                <div class="font-primary font-bold text-base text-foreground md:text-right" data-line-price>
                  {{ item.final_line_price | money }}
                </div>
              </div>
            {% endfor %}

          </div>

          <div class="border-2 border-foreground rounded-md p-6 bg-background flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <span class="font-primary font-bold uppercase text-base text-foreground">{{ 'cart.subtotal' | t }}</span>
              <span class="font-primary font-bold text-xl text-foreground" data-cart-subtotal>{{ cart.total_price | money }}</span>
            </div>
            <p class="m-0 text-xs text-muted">{{ 'cart.taxes_note' | t }}</p>

            <button
              type="submit"
              name="checkout"
              data-magnetic
              class="font-primary inline-flex items-center justify-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3.5 cursor-pointer"
            >
              <span class="hover-rollup leading-[1.3] h-[1.3em]">
                <span class="hover-rollup__item">{{ 'cart.checkout' | t }}</span>
                <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ 'cart.checkout' | t }}</span>
              </span>
              <span class="inline-flex shrink-0" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </button>
          </div>
        </form>
      {% endif %}

    </div>
  </div>
</div>

{% stylesheet %}
  [data-cart-qty]::-webkit-outer-spin-button,
  [data-cart-qty]::-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  [data-cart-qty] {
    -moz-appearance: textfield;
    appearance: textfield;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var form = document.querySelector('[data-cart-form]');
    if (!form) return;

    /* Safety net: if the server-rendered aspect-ratio is missing, correct
       each image box from its natural size once loaded. */
    document.querySelectorAll('[data-cart-image]').forEach(function (box) {
      var img = box.querySelector('img');
      if (!img) return;
      var apply = function () {
        if (img.naturalWidth && img.naturalHeight) {
          box.style.aspectRatio = img.naturalWidth + ' / ' + img.naturalHeight;
        }
      };
      if (img.complete && img.naturalWidth) {
        apply();
      } else {
        img.addEventListener('load', apply, { once: true });
      }
    });

    var currency = form.dataset.currency || 'USD';
    var locale = (form.dataset.locale || 'en-US').replace(/_/g, '-');
    var formatter = null;
    try {
      formatter = new Intl.NumberFormat(locale, { style: 'currency', currency: currency });
    } catch (e) {
      formatter = null;
    }

    function money(cents) {
      if (formatter) return formatter.format(cents / 100);
      return (cents / 100).toFixed(2);
    }

    function setLoading(row, loading) {
      row.querySelectorAll('[data-qty-minus], [data-qty-plus], [data-cart-qty]').forEach(function (el) {
        el.disabled = loading;
      });
    }

    function refreshMinus(row) {
      var input = row.querySelector('[data-cart-qty]');
      var minus = row.querySelector('[data-qty-minus]');
      if (input && minus && !input.disabled) {
        minus.disabled = Number(input.value) <= 1;
      }
    }

    function updateQty(key, qty, row, input) {
      setLoading(row, true);
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: key, quantity: qty })
      })
        .then(function (response) { return response.json(); })
        .then(function (cart) {
          if (!cart || cart.item_count === 0) {
            window.location.reload();
            return;
          }
          var updated = (cart.items || []).filter(function (it) { return it.key === key; })[0];
          if (!updated) {
            row.remove();
          } else {
            if (input) input.value = updated.quantity;
            var lineEl = row.querySelector('[data-line-price]');
            if (lineEl) lineEl.textContent = money(updated.final_line_price);
          }
          var subtotal = document.querySelector('[data-cart-subtotal]');
          if (subtotal) subtotal.textContent = money(cart.total_price);
          var badge = document.querySelector('[data-cart-count]');
          if (badge) {
            badge.textContent = cart.item_count;
            badge.style.display = cart.item_count > 0 ? '' : 'none';
          }
          setLoading(row, false);
          refreshMinus(row);
        })
        .catch(function () {
          window.location.reload();
        });
    }

    document.querySelectorAll('[data-qty-control]').forEach(function (ctrl) {
      var key = ctrl.dataset.itemKey;
      var row = ctrl.closest('[data-cart-item]');
      if (!key || !row) return;
      var input = ctrl.querySelector('[data-cart-qty]');
      var minus = ctrl.querySelector('[data-qty-minus]');
      var plus = ctrl.querySelector('[data-qty-plus]');
      var remove = row.querySelector('[data-qty-remove]');

      function commit(qty) {
        qty = Math.max(0, Math.floor(Number(qty) || 0));
        updateQty(key, qty, row, input);
      }

      if (minus) {
        minus.addEventListener('click', function () {
          commit(Number(input.value) - 1);
        });
      }
      if (plus) {
        plus.addEventListener('click', function () {
          commit(Number(input.value) + 1);
        });
      }
      if (remove) {
        remove.addEventListener('click', function () {
          commit(0);
        });
      }

      var typingTimeout;
      input.addEventListener('change', function () {
        clearTimeout(typingTimeout);
        commit(input.value);
      });
      input.addEventListener('input', function () {
        clearTimeout(typingTimeout);
        typingTimeout = setTimeout(function () {
          commit(input.value);
        }, 800);
      });

      refreshMinus(row);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your shopping bag"
    },
    {
      "type": "url",
      "id": "continue_shopping_url",
      "label": "Continue shopping URL"
    }
  ]
}
{% endschema %}
