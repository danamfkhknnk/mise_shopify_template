{% liquid
  if section.settings.collection != blank
    assign product_collection = collections[section.settings.collection]
  endif
%}

<div class="full-width w-full" data-service>
  <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
    <div class="bg-white border-2 border-foreground rounded-md p-8 md:p-12">

      {% comment %} Hero header {% endcomment %}
      <div class="text-center mb-12 md:mb-16">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h1 data-service-heading class="font-primary m-0 text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.05] uppercase mt-4">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div data-service-desc class="mt-4 text-base leading-relaxed text-muted max-w-[52ch] mx-auto [&_p]:m-0">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      {% if product_collection != blank and product_collection.products.size > 0 %}

        {% comment %} Tag filter bubbles {% endcomment %}
        {% if product_collection.all_tags.size > 0 %}
          <div data-service-filters class="mb-10 flex flex-nowrap gap-3 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden justify-center">
            <button
              data-filter="all"
              class="service-filter service-filter--active shrink-0 px-5 py-2 rounded-full font-primary text-sm font-bold uppercase tracking-wide border-2 border-foreground cursor-pointer"
            >
              {{ 'general.all' | t | default: 'All' }}
            </button>
            {% for tag in product_collection.all_tags %}
              <button
                data-filter="{{ tag | strip | handleize }}"
                class="service-filter shrink-0 px-5 py-2 rounded-full font-primary text-sm font-bold uppercase tracking-wide border-2 border-foreground bg-white text-muted cursor-pointer"
              >
                {{ tag }}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% comment %} Masonry product grid {% endcomment %}
        <div data-service-grid class="relative">
          {% for product in product_collection.products %}
            {% assign featured_image = product.featured_image %}
            {% assign image_ratio = featured_image.aspect_ratio | default: 1.0 %}

            {% capture product_tag_list %}{% for tag in product.tags %}{{ tag | strip | handleize }}|{% endfor %}{% endcapture %}

            <a
              data-service-card
              data-tags="{{ product_tag_list }}"
              data-ratio="{{ image_ratio }}"
              href="{{ product.url }}"
              class="service-card absolute top-0 left-0 block overflow-hidden rounded-md no-underline text-inherit border-2 border-foreground bg-white"
            >
              <div class="overflow-hidden">
                {% if product.images.size > 1 and section.settings.show_slideshow %}
                  <div data-slideshow class="relative w-full" style="aspect-ratio: {{ featured_image.width }} / {{ featured_image.height }};">
                    {% for image in product.images %}
                      {% liquid
                        assign slide_class = 'product-img absolute inset-0 h-full w-full object-cover'
                        if forloop.first
                          assign slide_class = slide_class | append: ' is-active'
                        endif
                      %}
                      {{ image | image_url: width: 800 | image_tag: class: slide_class, loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 40vw, 80vw' }}
                    {% endfor %}
                  </div>
                {% elsif featured_image %}
                  {{ featured_image | image_url: width: 800 | image_tag: class: 'product-img block w-full', loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 40vw, 80vw' }}
                {% else %}
                  <div class="flex aspect-square w-full items-center justify-center bg-background">
                    <svg class="w-16 h-16 text-muted opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <div class="p-5">
                {% if product.tags.size > 0 %}
                  <p class="m-0 mb-2 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-wide text-accent">
                    {% for tag in product.tags %}<span>#{{ tag }}</span>{% endfor %}
                  </p>
                {% endif %}

                <h3 class="font-primary m-0 text-base font-bold uppercase tracking-wide text-foreground">{{ product.title }}</h3>

                <div class="flex items-center justify-between gap-3 mt-2">
                  <span class="font-primary text-sm font-bold text-foreground">
                    {% if product.price_varies %}
                      {{ 'products.product.from' | t }} {{ product.price_min | money }}
                    {% else %}
                      {{ product.price | money }}
                    {% endif %}
                  </span>
                  <span class="view-link inline-flex items-center gap-1.5 font-primary text-xs font-bold uppercase text-accent">
                    {{ 'products.product.view_detail' | t | default: 'View' }}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          {% endfor %}
        </div>

      {% elsif section.blocks.size > 0 %}

        {% comment %} Fallback: manual service cards {% endcomment %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for block in section.blocks %}
            {% if block.type == 'service-card' %}
              <div
                class="service-card border-2 border-foreground rounded-md bg-white overflow-hidden text-center"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.image %}
                  <div class="overflow-hidden">
                    {{ block.settings.image | image_url: width: 600 | image_tag: class: 'product-img block w-full', loading: 'lazy' }}
                  </div>
                {% endif %}
                <div class="p-6">
                  <h3 class="font-primary m-0 text-base font-bold uppercase tracking-wide text-foreground">{{ block.settings.title }}</h3>
                  {% if block.settings.description != blank %}
                    <p class="mt-2 text-sm leading-relaxed text-muted">{{ block.settings.description }}</p>
                  {% endif %}
                  {% if block.settings.price != blank %}
                    <p class="mt-3 font-primary text-sm font-bold text-accent">{{ block.settings.price }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

      {% endif %}

      {% comment %} CTA button {% endcomment %}
      {% if section.settings.button_label != blank %}
        <div class="text-center mt-12">
          <a
            href="{{ section.settings.button_url | default: routes.collections_url }}"
            data-magnetic
            class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 no-underline"
          >
            <span class="hover-rollup leading-[1.3] h-[1.3em]">
              <span class="hover-rollup__item">{{ section.settings.button_label }}</span>
              <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ section.settings.button_label }}</span>
            </span>
            <span class="inline-flex shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</div>

{% stylesheet %}
  /* Card hover: lift + shadow grow */
  .service-card {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 4px 4px 0 var(--color-foreground);
  }

  /* Product image zoom on card hover */
  .product-img {
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .service-card:hover .product-img {
    transform: scale(1.06);
  }

  /* Multi-image slideshow crossfade */
  .product-slide {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-slide.is-active {
    opacity: 1;
  }

  /* View link gap expand on hover */
  .view-link {
    transition: gap 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .service-card:hover .view-link {
    gap: 0.75rem;
  }

  /* Filter tabs */
  .service-filter {
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .service-filter--active {
    background: var(--color-accent);
    color: #fff;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var section = document.querySelector('[data-service]');
    if (!section) return;

    /* ========== Masonry layout ========== */
    var GRID_GAP = 24;
    var grid = section.querySelector('[data-service-grid]');
    var allCards = grid ? Array.prototype.slice.call(grid.querySelectorAll('[data-service-card]')) : [];

    function ratiosLookSimilar(a, b) {
      if (!a || !b) return false;
      return Math.abs(a - b) / Math.max(a, b) < 0.15;
    }

    function getColumnCount(width) {
      if (width < 640) return 1;
      if (width < 1024) return 2;
      return 3;
    }

    function layoutMasonry(cards) {
      if (!grid || !cards.length) return;
      var containerWidth = grid.clientWidth;
      var columnCount = getColumnCount(window.innerWidth);
      var columnWidth = (containerWidth - GRID_GAP * (columnCount - 1)) / columnCount;

      cards.forEach(function (card) { card.style.width = columnWidth + 'px'; });

      var columnHeights = new Array(columnCount).fill(0);
      var columnLastRatio = new Array(columnCount).fill(null);

      cards.forEach(function (card) {
        var ratio = parseFloat(card.dataset.ratio) || 1;

        var targetCol = 0;
        for (var c = 1; c < columnCount; c++) {
          if (columnHeights[c] < columnHeights[targetCol]) targetCol = c;
        }

        if (ratiosLookSimilar(ratio, columnLastRatio[targetCol])) {
          var altCol = -1;
          for (var c2 = 0; c2 < columnCount; c2++) {
            if (c2 === targetCol || ratiosLookSimilar(ratio, columnLastRatio[c2])) continue;
            if (altCol === -1 || columnHeights[c2] < columnHeights[altCol]) altCol = c2;
          }
          if (altCol !== -1 && (columnHeights[altCol] - columnHeights[targetCol]) < columnWidth) {
            targetCol = altCol;
          }
        }

        var x = targetCol * (columnWidth + GRID_GAP);
        var y = columnHeights[targetCol];
        var itemHeight = card.offsetHeight;

        card.style.left = x + 'px';
        card.style.top = y + 'px';

        columnHeights[targetCol] = y + itemHeight + GRID_GAP;
        columnLastRatio[targetCol] = ratio;
      });

      grid.style.height = (Math.max.apply(Math, columnHeights) - GRID_GAP) + 'px';
    }

    function getVisibleCards() {
      return allCards.filter(function (card) { return card.style.display !== 'none'; });
    }

    if (allCards.length) {
      layoutMasonry(allCards);

      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () { layoutMasonry(getVisibleCards()); }, 150);
      });
    }

    /* ========== Slideshow crossfade ========== */
    var slideshows = section.querySelectorAll('[data-slideshow]');
    slideshows.forEach(function (el) {
      var slides = Array.prototype.slice.call(el.querySelectorAll('.product-img'));
      if (slides.length < 2) return;

      var current = 0;
      setInterval(function () {
        slides[current].classList.remove('is-active');
        current = (current + 1) % slides.length;
        slides[current].classList.add('is-active');
      }, 3200);
    });

    /* ========== Tag filtering ========== */
    var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-filter]'));
    var cards = allCards;

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var filter = tab.dataset.filter;

        tabs.forEach(function (t) {
          t.classList.remove('service-filter--active');
          t.classList.remove('bg-[var(--color-accent)]', 'text-white');
          t.classList.add('bg-white', 'text-muted');
        });
        tab.classList.add('service-filter--active');
        tab.classList.remove('bg-white', 'text-muted');
        tab.classList.add('bg-[var(--color-accent)]', 'text-white');

        cards.forEach(function (card) {
          var tags = (card.dataset.tags || '').split('|');
          var matches = filter === 'all' || tags.indexOf(filter) !== -1;

          if (typeof gsap === 'undefined') {
            card.style.display = matches ? 'block' : 'none';
            return;
          }

          if (matches) {
            card.style.display = 'block';
            gsap.to(card, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' });
          } else {
            gsap.to(card, {
              opacity: 0, scale: 0.95, duration: 0.3, ease: 'power2.in',
              onComplete: function () { card.style.display = 'none'; }
            });
          }
        });

        setTimeout(function () { layoutMasonry(getVisibleCards()); }, 320);
      });
    });

    /* ========== GSAP scroll animations ========== */
    function initAnimations() {
      var helpers = window.ArthehopeAnims;
      if (!window.gsap) return;
      if (helpers.prefersReduced()) return;

      var hasST = !!window.ScrollTrigger;
      if (hasST) window.gsap.registerPlugin(window.ScrollTrigger);

      function scrollProps(trigger, extra) {
        var props = { trigger: trigger, start: 'top 82%' };
        if (extra) {
          for (var k in extra) props[k] = extra[k];
        }
        return props;
      }

      /* Badge entrance */
      var badge = section.querySelector('.about-badge');
      if (badge && hasST) {
        window.gsap.from(badge, {
          scale: 0, rotation: -10, duration: 0.5, ease: 'back.out(1.7)',
          scrollTrigger: scrollProps(badge)
        });
      }

      /* Heading words */
      var heading = section.querySelector('[data-service-heading]');
      if (heading && hasST) {
        var words = helpers.splitWords(heading);
        if (words.length) {
          window.gsap.from(words, {
            yPercent: 110, duration: 0.6, stagger: 0.07, ease: 'power3.out',
            scrollTrigger: scrollProps(heading)
          });
        }
      }

      /* Description */
      var desc = section.querySelector('[data-service-desc]');
      if (desc && hasST) {
        window.gsap.from(desc, {
          y: 24, autoAlpha: 0, duration: 0.5, ease: 'power3.out',
          scrollTrigger: scrollProps(desc)
        });
      }

      /* Filter tabs cascade */
      var filterEls = section.querySelectorAll('[data-filter]');
      if (filterEls.length && hasST) {
        window.gsap.from(filterEls, {
          x: -24, autoAlpha: 0, duration: 0.5, stagger: 0.08, ease: 'power2.out',
          scrollTrigger: scrollProps(section.querySelector('[data-service-filters]'))
        });
      }

      /* Product cards batch reveal */
      if (allCards.length && hasST) {
        window.ScrollTrigger.batch('[data-service-card]', {
          start: 'top 90%',
          once: true,
          onEnter: function (els) {
            window.gsap.fromTo(els,
              { y: 70, autoAlpha: 0, rotation: function () { return window.gsap.utils.random(-5, 5); } },
              {
                y: 0, autoAlpha: 1, rotation: 0, duration: 0.7,
                ease: 'back.out(1.4)', stagger: 0.1,
                clearProps: 'transform,opacity,visibility'
              }
            );
          }
        });
      }

      /* CTA button pop-in */
      var cta = section.querySelector('[data-magnetic]');
      if (cta && hasST) {
        window.gsap.from(cta, {
          scale: 0, duration: 0.6, ease: 'back.out(1.7)',
          scrollTrigger: scrollProps(cta, { start: 'top 88%' })
        });
      }
    }

    if (window.ArthehopeAnims) {
      window.ArthehopeAnims.whenGsap(initAnimations);
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Service",
  "blocks": [
    {
      "type": "service-card",
      "name": "Service card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Portrait"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Detailed character portraits with custom backgrounds"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$50"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "My services"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT I OFFER"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Custom artwork tailored to your vision. Every piece is crafted with care and attention to detail.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_slideshow",
      "label": "Enable image slideshow for multi-image products",
      "default": true
    },
    {
      "type": "header",
      "content": "CTA button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Service",
      "blocks": [
        {
          "type": "service-card",
          "settings": { "title": "Portrait", "description": "Detailed character portraits with custom backgrounds", "price": "$50" }
        },
        {
          "type": "service-card",
          "settings": { "title": "Character Design", "description": "Full character sheets with multiple poses", "price": "$120" }
        },
        {
          "type": "service-card",
          "settings": { "title": "Illustration", "description": "Full scene illustrations with complex compositions", "price": "$200" }
        }
      ]
    }
  ]
}
{% endschema %}
