{% liquid
  assign product_type_downcase = section.settings.product_type | downcase
  assign product_count = 0

  for product in collections.all.products
    assign ptype = product.type | downcase
    if ptype == product_type_downcase
      assign product_count = product_count | plus: 1
    endif
  endfor
%}

<div class="full-width w-full" data-service>
  <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
    <div class="bg-white border-2 border-foreground rounded-md p-8 md:p-12">

      {% comment %} Hero header {% endcomment %}
      <div class="text-center mb-12 md:mb-16">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h1 data-service-heading class="font-primary m-0 text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.05] uppercase">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div data-service-desc class="mt-4 text-base leading-relaxed text-accent max-w-[52ch] mx-auto [&_p]:m-0">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      {% if product_count > 0 %}

        {% comment %} Tag filter bubbles — collect unique tags from filtered products {% endcomment %}
        {% assign tags_collected = '' %}
        {% for product in collections.all.products %}
          {% assign ptype = product.type | downcase %}
          {% if ptype == product_type_downcase %}
            {% for tag in product.tags %}
              {% assign tag_lower = tag | strip | downcase %}
              {% unless tags_collected contains tag_lower %}
                {% capture tags_collected %}{{ tags_collected }}{{ tag_lower }}|{% endcapture %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endfor %}
        {% assign tags_array = tags_collected | split: '|' %}
        {% if tags_array.size > 1 %}
          <div data-service-filters class="mb-10 flex flex-nowrap gap-3 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden justify-center">
            <button
              data-filter="all"
              class="service-filter service-filter--active shrink-0 px-5 py-2 rounded-full font-primary text-sm font-bold uppercase tracking-wide cursor-pointer"
              style="background: var(--color-accent); color: white; border: 1px solid rgba(45,42,38,0.06);"
            >
              All
            </button>
            {% for tag in tags_array %}
              {% if tag != blank %}
                <button
                  data-filter="{{ tag }}"
                  class="service-filter shrink-0 px-5 py-2 rounded-full font-primary text-sm font-bold uppercase tracking-wide cursor-pointer"
                  style="background: rgba(255,255,255,0.6); color: var(--color-muted); border: 1px solid rgba(45,42,38,0.06);"
                >
                  {{ tag }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% comment %} Collection Products — Pinterest-style masonry {% endcomment %}
        <div data-service-grid class="relative">
          {% for product in collections.all.products %}
            {% assign ptype = product.type | downcase %}
            {% if ptype == product_type_downcase %}
              {% assign featured_image = product.featured_image %}
              {% assign image_ratio = featured_image.aspect_ratio | default: 1.0 %}

              {% capture product_tag_list %}{% for tag in product.tags %}{{ tag | strip | downcase }}|{% endfor %}{% endcapture %}

              <a
                data-service-card
                data-tags="{{ product_tag_list }}"
                data-ratio="{{ image_ratio }}"
                href="{{ product.url }}"
                class="service-card group absolute top-0 left-0 block overflow-hidden rounded-md no-underline text-inherit border-2 border-foreground bg-white cursor-none"
                style="opacity: 0;"
              >
                <div
                  data-service-card-cursor
                  class="pointer-events-none absolute z-10 flex h-8 w-20 -translate-x-1/2 -translate-y-1/2 scale-75 items-center justify-center overflow-hidden rounded-full border-2 border-foreground bg-white opacity-0 transition-[opacity,transform] duration-200 ease-out group-hover:scale-100 group-hover:opacity-100"
                  style="left: var(--service-cursor-x, -999px); top: var(--service-cursor-y, -999px);"
                  aria-hidden="true"
                >
                  <div class="flex w-max items-center gap-3 whitespace-nowrap font-primary text-xs font-bold uppercase text-accent animate-hero-marquee [animation-duration:6s] motion-reduce:animate-none">
                    {% for i in (1..8) %}
                      <span>{{ 'products.product.view_detail' | t | default: 'View more' }}</span>
                      <span aria-hidden="true">&middot;</span>
                    {% endfor %}
                  </div>
                </div>

                <div class="relative overflow-hidden">
                  {% if product.images.size > 1 %}
                    <div data-slideshow class="relative w-full" style="aspect-ratio: {{ featured_image.width }} / {{ featured_image.height }};">
                      {% for image in product.images %}
                        <img
                          data-slide
                          src="{{ image | image_url: width: 800 }}"
                          alt="{{ product.title }}"
                          class="product-img product-slide absolute inset-0 h-full w-full object-cover{% if forloop.first %} is-active{% endif %}"
                          loading="lazy"
                          width="{{ image.width }}"
                          height="{{ image.height }}"
                        >
                      {% endfor %}
                    </div>
                  {% elsif featured_image %}
                    <img
                      src="{{ featured_image | image_url: width: 800 }}"
                      alt="{{ product.title }}"
                      class="product-img block h-auto w-full"
                      loading="lazy"
                      width="{{ featured_image.width }}"
                      height="{{ featured_image.height }}"
                    >
                  {% else %}
                    <div class="flex aspect-square w-full items-center justify-center bg-background">
                      <svg class="w-16 h-16 text-muted opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                  {% endif %}
                </div>

                <div class="p-5">
                  {% if product.tags.size > 0 %}
                    <p class="m-0 mb-2 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-wide text-accent">
                      {% for tag in product.tags %}<span>#{{ tag }}</span>{% endfor %}
                    </p>
                  {% endif %}

                  <h3 class="font-primary m-0 text-base font-bold uppercase tracking-wide text-foreground">{{ product.title }}</h3>

                  <div class="flex items-center justify-between gap-3 mt-2">
                    <span class="font-primary text-sm font-bold text-foreground">
                      {% if product.price_varies %}
                        {{ 'products.product.from' | t }} <span class="text-accent">{{ product.price_min | money }}</span>
                      {% else %}
                        {{ product.price | money }}
                      {% endif %}
                    </span>
                    
                  </div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>

        <script>
          (function () {
            var section = document.currentScript.closest('[data-service]');
            if (!section) return;

            /* ========== Masonry layout ========== */
            var GRID_GAP = 24;
            var grid = section.querySelector('[data-service-grid]');
            var allCards = Array.prototype.slice.call(section.querySelectorAll('[data-service-card]'));

            /* ========== Custom "view more" cursor follower ========== */
            allCards.forEach(function (card) {
              card.addEventListener('mousemove', function (e) {
                var rect = card.getBoundingClientRect();
                card.style.setProperty('--service-cursor-x', (e.clientX - rect.left) + 'px');
                card.style.setProperty('--service-cursor-y', (e.clientY - rect.top) + 'px');
              });
            });

            var ratiosLookSimilar = function (a, b) {
              if (!a || !b) return false;
              return Math.abs(a - b) / Math.max(a, b) < 0.15;
            };

            var getColumnCount = function (width) {
              if (width < 640) return 1;
              if (width < 1024) return 2;
              return 3;
            };

            function layoutMasonry(cards) {
              if (!grid || !cards.length) return;
              var containerWidth = grid.clientWidth;
              var columnCount = getColumnCount(window.innerWidth);
              var columnWidth = (containerWidth - GRID_GAP * (columnCount - 1)) / columnCount;

              cards.forEach(function (card) { card.style.width = columnWidth + 'px'; });

              var columnHeights = new Array(columnCount).fill(0);
              var columnLastRatio = new Array(columnCount).fill(null);

              cards.forEach(function (card) {
                var ratio = parseFloat(card.dataset.ratio) || 1;

                var targetCol = 0;
                for (var c = 1; c < columnCount; c++) {
                  if (columnHeights[c] < columnHeights[targetCol]) targetCol = c;
                }

                if (ratiosLookSimilar(ratio, columnLastRatio[targetCol])) {
                  var altCol = -1;
                  for (var c2 = 0; c2 < columnCount; c2++) {
                    if (c2 === targetCol || ratiosLookSimilar(ratio, columnLastRatio[c2])) continue;
                    if (altCol === -1 || columnHeights[c2] < columnHeights[altCol]) altCol = c2;
                  }
                  if (altCol !== -1 && (columnHeights[altCol] - columnHeights[targetCol]) < columnWidth) {
                    targetCol = altCol;
                  }
                }

                var x = targetCol * (columnWidth + GRID_GAP);
                var y = columnHeights[targetCol];
                var itemHeight = card.offsetHeight;

                card.style.left = x + 'px';
                card.style.top = y + 'px';

                columnHeights[targetCol] = y + itemHeight + GRID_GAP;
                columnLastRatio[targetCol] = ratio;
              });

              grid.style.height = (Math.max.apply(Math, columnHeights) - GRID_GAP) + 'px';
            }

            var getVisibleCards = function () {
              return allCards.filter(function (card) { return card.style.display !== 'none'; });
            };

            /* ========== Scatter-from-center entrance animation ========== */
            function scatterEntrance() {
              if (!grid || !allCards.length) return;

              var hasGSAP = typeof gsap !== 'undefined';

              /* Step 1: compute masonry positions (cards are opacity:0, invisible) */
              layoutMasonry(allCards);

              /* Step 2: store final positions, then move cards to center */
              var gridRect = grid.getBoundingClientRect();
              var gridCenterX = gridRect.left + gridRect.width / 2;
              var gridCenterY = gridRect.top + gridRect.height / 2;

              allCards.forEach(function (card) {
                var finalLeft = parseFloat(card.style.left) || 0;
                var finalTop = parseFloat(card.style.top) || 0;
                card.dataset.finalLeft = finalLeft;
                card.dataset.finalTop = finalTop;

                /* Move to center of grid */
                var cardRect = card.getBoundingClientRect();
                var cardCenterX = cardRect.left + cardRect.width / 2;
                var cardCenterY = cardRect.top + cardRect.height / 2;

                var offsetX = gridCenterX - cardCenterX;
                var offsetY = gridCenterY - cardCenterY;

                card.dataset.offsetX = offsetX;
                card.dataset.offsetY = offsetY;

                /* Start at center */
                card.style.left = (finalLeft + offsetX) + 'px';
                card.style.top = (finalTop + offsetY) + 'px';
              });

              /* Step 3: animate to final positions */
              if (hasGSAP) {
                allCards.forEach(function (card, i) {
                  gsap.to(card, {
                    left: card.dataset.finalLeft + 'px',
                    top: card.dataset.finalTop + 'px',
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 0.8,
                    delay: i * 0.08,
                    ease: 'back.out(1.4)'
                  });
                });
              } else {
                /* Fallback without GSAP */
                allCards.forEach(function (card, i) {
                  setTimeout(function () {
                    card.style.left = card.dataset.finalLeft + 'px';
                    card.style.top = card.dataset.finalTop + 'px';
                    card.style.opacity = '1';
                    card.style.transition = 'all 0.6s ease';
                  }, i * 80);
                });
              }
            }

            /* Run scatter entrance after images load (or after timeout) */
            function waitForImagesThenScatter() {
              var images = grid ? grid.querySelectorAll('img') : [];
              var loaded = 0;
              var total = images.length;

              if (total === 0) {
                scatterEntrance();
                return;
              }

              function checkDone() {
                loaded++;
                if (loaded >= total) {
                  scatterEntrance();
                }
              }

              images.forEach(function (img) {
                if (img.complete) {
                  checkDone();
                } else {
                  img.addEventListener('load', checkDone);
                  img.addEventListener('error', checkDone);
                }
              });

              /* Fallback: run after 2s even if images haven't loaded */
              setTimeout(function () {
                if (loaded < total) scatterEntrance();
              }, 2000);
            }

            waitForImagesThenScatter();

            /* ========== Resize handler ========== */
            var resizeTimer;
            window.addEventListener('resize', function () {
              clearTimeout(resizeTimer);
              resizeTimer = setTimeout(function () { layoutMasonry(getVisibleCards()); }, 150);
            });

            /* ========== Slideshow crossfade ========== */
            var slideshows = section.querySelectorAll('[data-slideshow]');
            slideshows.forEach(function (el) {
              var slides = Array.prototype.slice.call(el.querySelectorAll('[data-slide]'));
              if (slides.length < 2) return;

              var current = 0;
              setInterval(function () {
                slides[current].classList.remove('is-active');
                current = (current + 1) % slides.length;
                slides[current].classList.add('is-active');
              }, 3200);
            });

            /* ========== Tag filter bubbles ========== */
            var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-filter]'));
            var cards = Array.prototype.slice.call(section.querySelectorAll('[data-service-card]'));
            tabs.forEach(function (tab) {
              tab.addEventListener('click', function () {
                var filter = tab.dataset.filter;

                tabs.forEach(function (t) {
                  t.classList.remove('service-filter--active');
                  t.style.background = 'rgba(255,255,255,0.6)';
                  t.style.color = 'var(--color-muted)';
                  t.style.border = '1px solid rgba(45,42,38,0.06)';
                });
                tab.classList.add('service-filter--active');
                tab.style.background = 'var(--color-accent)';
                tab.style.color = 'white';
                tab.style.border = 'none';

                cards.forEach(function (card) {
                  var tags = (card.dataset.tags || '').split('|');
                  var matches = filter === 'all' || tags.indexOf(filter) !== -1;

                  if (typeof gsap === 'undefined') {
                    card.style.display = matches ? 'block' : 'none';
                    return;
                  }

                  if (matches) {
                    card.style.display = 'block';
                    gsap.to(card, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' });
                  } else {
                    gsap.to(card, {
                      opacity: 0, scale: 0.95, duration: 0.3, ease: 'power2.in',
                      onComplete: function () { card.style.display = 'none'; }
                    });
                  }
                });

                setTimeout(function () { layoutMasonry(getVisibleCards()); }, 320);
              });
            });

          })();
        </script>

      {% elsif section.blocks.size > 0 %}

        {% comment %} Fallback: manual service cards {% endcomment %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for block in section.blocks %}
            {% if block.type == 'service-card' %}
              <div
                class="service-card border-2 border-foreground rounded-md bg-white overflow-hidden text-center"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.image %}
                  <div class="overflow-hidden">
                    {{ block.settings.image | image_url: width: 600 | image_tag: class: 'product-img block w-full', loading: 'lazy' }}
                  </div>
                {% endif %}
                <div class="p-6">
                  <h3 class="font-primary m-0 text-base font-bold uppercase tracking-wide text-foreground">{{ block.settings.title }}</h3>
                  {% if block.settings.description != blank %}
                    <p class="mt-2 text-sm leading-relaxed text-muted">{{ block.settings.description }}</p>
                  {% endif %}
                  {% if block.settings.price != blank %}
                    <p class="mt-3 font-primary text-sm font-bold text-accent">{{ block.settings.price }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

      {% endif %}

    </div>
  </div>
</div>

<style>
  /* Card hover: lift + shadow grow */
  [data-service-card] {
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  [data-service-card]:hover {
    transform: translateY(-6px);
    box-shadow: 4px 4px 0 var(--color-foreground);
  }

  /* Product image zoom on card hover */
  .product-img {
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  [data-service-card]:hover .product-img {
    transform: scale(1.06);
  }

  /* Multi-image slideshow crossfade */
  .product-slide {
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-slide.is-active {
    opacity: 1;
  }

  /* View link gap expand on hover */
  .view-link {
    transition: gap 0.6s cubic-bezier(0.16, 0.4, 0.3, 1), color 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-service-card]:hover .view-link {
    gap: 0.5rem;
  }
</style>

{% schema %}
{
  "name": "Service",
  "blocks": [
    {
      "type": "service-card",
      "name": "Service card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Portrait"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Detailed character portraits with custom backgrounds"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$50"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "My services"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT I OFFER"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Custom artwork tailored to your vision. Every piece is crafted with care and attention to detail.</p>"
    },
    {
      "type": "text",
      "id": "product_type",
      "label": "Product type",
      "default": "Digital Art"
    },
    {
      "type": "checkbox",
      "id": "show_slideshow",
      "label": "Enable image slideshow for multi-image products",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Service",
      "blocks": [
        {
          "type": "service-card",
          "settings": { "title": "Portrait", "description": "Detailed character portraits with custom backgrounds", "price": "$50" }
        },
        {
          "type": "service-card",
          "settings": { "title": "Character Design", "description": "Full character sheets with multiple poses", "price": "$120" }
        },
        {
          "type": "service-card",
          "settings": { "title": "Illustration", "description": "Full scene illustrations with complex compositions", "price": "$200" }
        }
      ]
    }
  ]
}
{% endschema %}
