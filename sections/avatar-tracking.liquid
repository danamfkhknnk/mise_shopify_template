{% liquid
  assign default_model_url = 'lily.vrm' | asset_url
  assign model_url = section.settings.model_url | default: default_model_url
%}

<div
  class="full-width w-full"
  data-avatar-tracking
  data-model-url="{{ model_url }}"
  data-camera-distance="{{ section.settings.camera_distance }}"
  data-relaxed-pose="{{ section.settings.relaxed_pose }}"
  data-arm-spread="{{ section.settings.arm_spread | divided_by: 100.0 }}"
  data-face-camera="{{ section.settings.face_camera }}"
  data-pose-tracking="{{ section.settings.pose_tracking }}"
  data-status-loading="{{ 'sections.avatar_tracking.loading' | t }}"
  data-status-ready="{{ 'sections.avatar_tracking.ready' | t }}"
  data-error-load="{{ 'sections.avatar_tracking.error_load' | t }}"
  data-error-webgl="{{ 'sections.avatar_tracking.error_webgl' | t }}"
  data-status-initializing="{{ 'sections.avatar_tracking.initializing' | t }}"
  data-status-searching="{{ 'sections.avatar_tracking.face_searching' | t }}"
  data-status-active="{{ 'sections.avatar_tracking.tracking_active' | t }}"
  data-error-denied="{{ 'sections.avatar_tracking.camera_denied' | t }}"
  data-error-unavailable="{{ 'sections.avatar_tracking.camera_unavailable' | t }}"
  data-error-camera="{{ 'sections.avatar_tracking.camera_error' | t }}"
>
  <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
    <div class="card-bg-hero border-2 border-foreground rounded-md p-8 md:p-12 card-shadow">
      <div class="text-center mb-10">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h2 class="font-primary m-0 text-[clamp(2rem,5vw,3rem)] font-bold leading-[1.05] uppercase">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="mt-4 text-base leading-relaxed text-accent max-w-[52ch] mx-auto [&_p]:m-0">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="avatar-tracking__stage" data-avatar-stage>
        <canvas class="avatar-tracking__canvas" data-avatar-canvas></canvas>
        <p class="avatar-tracking__status" role="status" data-avatar-status></p>
      </div>

      <div class="avatar-tracking__controls">
        <button
          type="button"
          class="avatar-tracking__button"
          data-avatar-start
        >
          {{ 'sections.avatar_tracking.start_tracking' | t }}
        </button>
        <button
          type="button"
          class="avatar-tracking__button"
          data-avatar-stop
          hidden
        >
          {{ 'sections.avatar_tracking.stop_tracking' | t }}
        </button>
      </div>

      <div class="avatar-tracking__trackers" data-avatar-trackers hidden>
        <span class="avatar-tracking__tracker" data-tracker-face>{{ 'sections.avatar_tracking.tracking_face' | t }}</span>
        <span class="avatar-tracking__tracker" data-tracker-body>{{ 'sections.avatar_tracking.tracking_body' | t }}</span>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .avatar-tracking__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 2px solid var(--color-foreground);
    border-radius: 6px;
    background: var(--color-background);
  }

  .avatar-tracking__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .avatar-tracking__status {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    margin: 0;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-foreground);
    font-size: 0.8rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .avatar-tracking__status[hidden] {
    display: none;
  }

  .avatar-tracking__stage--error .avatar-tracking__status {
    background: var(--color-accent);
    color: #fff;
    white-space: normal;
    max-width: calc(100% - 24px);
    text-align: center;
  }

  .avatar-tracking__controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .avatar-tracking__button {
    font-family: var(--font-primary--family);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    padding: 12px 28px;
    border: 2px solid var(--color-foreground);
    border-radius: 6px;
    background: var(--color-accent);
    color: #fff;
    cursor: pointer;
  }

  .avatar-tracking__button[hidden] {
    display: none;
  }

  .avatar-tracking__button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .avatar-tracking__trackers {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }

  .avatar-tracking__trackers[hidden] {
    display: none;
  }

  .avatar-tracking__tracker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border: 2px solid var(--color-foreground);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    color: var(--color-muted);
  }

  .avatar-tracking__tracker--on {
    background: var(--color-accent);
    border-color: var(--color-foreground);
    color: #fff;
  }
{% endstylesheet %}

<script type="module">
  import { createAvatarRuntime } from '{{ 'avatar-runtime.js' | asset_url }}';

  /* Thin UI glue: the shared runtime owns the VRM, the webcam (hidden —
     no preview is ever shown) and the face/body trackers. */
  function initAvatarTracking(root) {
    if (!root || root._avatarCleanup) return;

    const stage = root.querySelector('[data-avatar-stage]');
    const canvas = root.querySelector('[data-avatar-canvas]');
    const status = root.querySelector('[data-avatar-status]');
    const btnStart = root.querySelector('[data-avatar-start]');
    const btnStop = root.querySelector('[data-avatar-stop]');
    const trackersRow = root.querySelector('[data-avatar-trackers]');
    const indFace = root.querySelector('[data-tracker-face]');
    const indBody = root.querySelector('[data-tracker-body]');
    if (!stage || !canvas) return;

    const setIndicators = (face, body) => {
      if (indFace) indFace.classList.toggle('avatar-tracking__tracker--on', !!face);
      if (indBody) indBody.classList.toggle('avatar-tracking__tracker--on', !!body);
    };

    const setTrackingUI = (isActive) => {
      if (btnStart) btnStart.hidden = isActive;
      if (btnStop) btnStop.hidden = !isActive;
      if (trackersRow) trackersRow.hidden = !isActive;
      if (!isActive) setIndicators(false, false);
    };

    const runtime = createAvatarRuntime({
      canvas,
      stage,
      statusEl: status,
      modelUrl: root.dataset.modelUrl,
      cameraDistance: parseFloat(root.dataset.cameraDistance) || 1.4,
      relaxedPose: root.dataset.relaxedPose !== 'false',
      armSpread: parseFloat(root.dataset.armSpread) || 0,
      faceCamera: root.dataset.faceCamera !== 'false',
      poseTracking: root.dataset.poseTracking !== 'false',
      strings: {
        statusLoading: root.dataset.statusLoading,
        statusReady: root.dataset.statusReady,
        errorLoad: root.dataset.errorLoad,
        errorWebgl: root.dataset.errorWebgl,
        statusInitializing: root.dataset.statusInitializing,
        statusSearching: root.dataset.statusSearching,
        statusActive: root.dataset.statusActive,
        errorDenied: root.dataset.errorDenied,
        errorUnavailable: root.dataset.errorUnavailable,
        errorCamera: root.dataset.errorCamera,
      },
      onDetect: (face, body) => setIndicators(face, body),
    });

    if (btnStart) {
      btnStart.addEventListener('click', async () => {
        if (btnStart.disabled) return;
        btnStart.disabled = true;
        const ok = await runtime.start();
        btnStart.disabled = false;
        setTrackingUI(!!ok);
      });
    }
    if (btnStop) {
      btnStop.addEventListener('click', () => {
        runtime.stop();
        setTrackingUI(false);
      });
    }

    root._avatarCleanup = () => {
      runtime.dispose();
      delete root._avatarCleanup;
    };
  }

  function initAllAvatarTracking() {
    document.querySelectorAll('[data-avatar-tracking]').forEach((root) => {
      initAvatarTracking(root);
    });
  }

  function cleanupAvatarTracking(root) {
    if (root && typeof root._avatarCleanup === 'function') root._avatarCleanup();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllAvatarTracking, { once: true });
  } else {
    initAllAvatarTracking();
  }

  document.addEventListener('shopify:section:load', (event) => {
    const root = event.target && event.target.querySelector
      ? event.target.querySelector('[data-avatar-tracking]')
      : null;
    if (event.target && event.target.matches && event.target.matches('[data-avatar-tracking]')) {
      initAvatarTracking(event.target);
    } else if (root) {
      initAvatarTracking(root);
    }
  });

  document.addEventListener('shopify:section:unload', (event) => {
    const root = event.target && event.target.querySelector
      ? event.target.querySelector('[data-avatar-tracking]')
      : null;
    if (event.target && event.target.matches && event.target.matches('[data-avatar-tracking]')) {
      cleanupAvatarTracking(event.target);
    } else if (root) {
      cleanupAvatarTracking(root);
    }
  });

  document.addEventListener('page:loaded', initAllAvatarTracking);
</script>

{% schema %}
{
  "name": "Avatar tracking",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Live avatar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Lily"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Your 3D companion, rendered live from a VRM model.</p>"
    },
    {
      "type": "text",
      "id": "model_url",
      "label": "VRM model URL (leave empty to use lily.vrm)",
      "info": "Defaults to assets/lily.vrm. If the theme push fails due to file size, upload the .vrm via Content > Files and paste its URL here."
    },
    {
      "type": "range",
      "id": "camera_distance",
      "label": "Camera distance",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "checkbox",
      "id": "relaxed_pose",
      "label": "Relaxed standing pose (arms down)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "face_camera",
      "label": "Turn model to face camera",
      "info": "Enable if the model initially shows its back. Depends on how the VRM file was authored.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pose_tracking",
      "label": "Track body (torso)",
      "info": "Follows your torso so the body leans and turns with the camera. Arms and hands keep the relaxed pose.",
      "default": true
    },
    {
      "type": "range",
      "id": "arm_spread",
      "label": "Arm distance from torso",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [{ "name": "Avatar tracking" }]
}
{% endschema %}
