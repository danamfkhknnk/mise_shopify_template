{% liquid
  assign hero_entry = metaobjects.hero.values | first
  assign about_image = hero_entry.image
%}

<div class="main-card full-width w-full">
  <div class="max-w-[1400px] mx-auto px-6 py-12 md:py-20">
    <div class="bg-white border-2 border-foreground rounded-md p-8 md:p-12">
      {% comment %} About section {% endcomment %}
      <div id="about" class="grid grid-cols-1 md:grid-cols-2 md:items-stretch gap-10 md:gap-16 scroll-mt-0 md:scroll-mt-2 lg:scroll-mt-32">
        <div>
          {% render 'badge', text: section.settings.about_badge_text %}

          {% if section.settings.about_heading != blank %}
            <h2 class="font-primary m-0 text-[clamp(2rem,5vw,3rem)] font-bold leading-[1.05] uppercase">
              {{ section.settings.about_heading }}
            </h2>
          {% endif %}

          {% if section.settings.about_description != blank %}
            <div class="mt-4 text-base leading-relaxed text-accent [&_p]:m-0 [&_p+p]:mt-4">
              {{ section.settings.about_description }}
            </div>
          {% endif %}

          {% if section.settings.about_cta_label != blank %}
            <a
              href="{{ section.settings.about_cta_url | default: '/pages/service' }}"
              data-magnetic
              class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 mt-8 no-underline"
            >
              <span class="hover-rollup leading-[1.3] h-[1.3em]">
                <span class="hover-rollup__item">{{ section.settings.about_cta_label }}</span>
                <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ section.settings.about_cta_label }}</span>
              </span>
              <span class="inline-flex shrink-0" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>

        <div class="about-orbit relative mx-auto w-full max-w-[640px]">
          <div class="border-2 border-foreground overflow-hidden h-[426px]" data-scroll-reveal>
            {% if about_image %}
              {{
                about_image
                | image_url: width: 900
                | image_tag:
                  class: 'scroll-reveal-img w-full h-full object-cover object-top',
                  loading: 'lazy',
                  sizes: '(min-width: 768px) 40vw, 80vw'
              }}
            {% else %}
              <div class="w-full h-full bg-muted"></div>
            {% endif %}
          </div>
        </div>
      </div>

      {% comment %} Portfolio section {% endcomment %}
      <div class="border-t-2 border-foreground mt-12"></div>
      <div id="portfolio" class="text-center pt-12 pb-4">
        {% render 'badge', text: section.settings.portfolio_badge %}

        {% if section.settings.portfolio_heading != blank %}
          <h2 class="font-primary m-0 text-[clamp(2rem,5vw,3rem)] font-bold leading-[1.05] uppercase text-foreground">
            {{ section.settings.portfolio_heading }}
          </h2>
        {% endif %}

        {% if section.settings.portfolio_description != blank %}
          <div class="mt-4 text-base leading-relaxed text-accent max-w-[52ch] mx-auto [&_p]:m-0">
            {{ section.settings.portfolio_description }}
          </div>
        {% endif %}

        <div class="grid grid-cols-2 md:grid-cols-3 gap-x-3 sm:gap-x-6 gap-y-10 mt-10 max-w-[820px] mx-auto justify-items-center" data-folders>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'portfolio-folder' %}
                {% assign folder_image = block.settings.image | default: about_image %}
                {% if block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="portfolio-folder group flex flex-col items-center min-w-0 max-w-full text-center no-underline text-inherit"
                    data-folder
                    {{ block.shopify_attributes }}
                  >
                {% else %}
                  <div
                    class="portfolio-folder group flex flex-col items-center min-w-0 max-w-full cursor-pointer text-center"
                    data-folder
                    tabindex="0"
                    role="button"
                    aria-label="{{ block.settings.title | escape }} — tap to peek"
                    {{ block.shopify_attributes }}
                  >
                {% endif %}
                  <div class="relative mx-auto w-full max-w-[160px]">
                    <div class="relative z-0 text-accent [&_svg]:block [&_svg]:w-full [&_svg]:h-auto" aria-hidden="true">
                      {{ 'folder-back.svg' | inline_asset_content }}
                    </div>
                    {% if folder_image %}
                      <div class="portfolio-folder__peek absolute left-[14%] right-[14%] bottom-[10%] h-[58%] z-[1] rounded bg-white translate-y-[4%] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-[90%] group-focus-within:-translate-y-[90%]" aria-hidden="true">
                        {{
                          folder_image
                          | image_url: width: 600
                          | image_tag:
                            class: 'rounded w-full h-full object-cover',
                            loading: 'lazy'
                        }}
                      </div>
                    {% endif %}
                    <div class="absolute inset-0 z-[2] pointer-events-none text-accent [&_svg]:block [&_svg]:w-full [&_svg]:h-auto" aria-hidden="true">
                      {{ 'folder-front.svg' | inline_asset_content }}
                    </div>
                  </div>
                  <div class="portfolio-folder__label font-primary inline-block border-2 border-foreground bg-white px-3 py-1.5 text-sm font-bold uppercase tracking-wide mt-[-11px] relative z-[2] rounded-[2px] -rotate-2 shadow-small max-w-full max-sm:text-[0.7rem] max-sm:leading-[1.2] max-sm:px-2 max-sm:py-1.5">
                    {{ block.settings.title }}
                  </div>
                {% if block.settings.link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>

      {% comment %} Gallery showcase section {% endcomment %}
      <div class="border-t-2 border-foreground mt-12"></div>
      <div id="gallery" class="text-center pt-12 pb-4 -scroll-mt-20 md:-scroll-mt-24">
        {% render 'badge', text: section.settings.gallery_badge %}

        {% if section.settings.gallery_heading != blank %}
          <h2 class="font-primary m-0 text-[clamp(2rem,5vw,3rem)] font-bold leading-[1.05] uppercase text-foreground">
            {{ section.settings.gallery_heading }}
          </h2>
        {% endif %}

        {% if section.settings.gallery_description != blank %}
          <div class="mt-4 text-base leading-relaxed text-accent max-w-[52ch] mx-auto [&_p]:m-0">
            {{ section.settings.gallery_description }}
          </div>
        {% endif %}

        {% liquid
          assign gallery_count = 0
          for block in section.blocks
            if block.type == 'gallery-image'
              assign gallery_count = gallery_count | plus: 1
            endif
          endfor
        %}

        <div data-gallery-viewport class="mt-10 text-left overflow-hidden cursor-default h-[560px] max-md:h-[440px] [mask-image:linear-gradient(to_bottom,transparent,black_8%,black_92%,transparent)] [-webkit-mask-image:linear-gradient(to_bottom,transparent,black_8%,black_92%,transparent)]">
          <div class="grid grid-cols-3 gap-4 h-full max-md:grid-cols-2 max-md:gap-3">
            {% for col in (0..2) %}
              <div class="overflow-hidden min-h-0 max-md:[&:nth-child(3)]:hidden">
                <div
                  class="flex flex-col w-full {% if col == 1 %}animate-gallery-down{% else %}animate-gallery-up{% endif %} motion-reduce:animate-none"
                >
                  {% for pass in (1..2) %}
                    <div
                      class="flex flex-col gap-4 pb-4 max-md:gap-3 max-md:pb-3"
                      {% if pass == 2 %}
                        aria-hidden="true"
                      {% endif %}
                    >
                      {% if gallery_count == 0 %}
                        {% for i in (1..4) %}
                          <div class="border-2 border-foreground rounded-md overflow-hidden bg-background odd:aspect-[3/4] even:aspect-square">
                            {% if about_image %}
                              {{
                                about_image
                                | image_url: width: 800
                                | image_tag:
                                  class: 'block w-full h-full object-cover',
                                  loading: 'lazy',
                                  sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 40vw, 80vw'
                              }}
                            {% else %}
                              <div class="w-full h-full bg-muted"></div>
                            {% endif %}
                          </div>
                        {% endfor %}
                      {% else %}
                        {% liquid
                          assign idx = 0
                        %}
                        {% for block in section.blocks %}
                          {% if block.type == 'gallery-image' %}
                            {% assign mod = idx | modulo: 3 %}
                            {% if mod == col %}
                              {% assign card_image = block.settings.image | default: about_image %}
                              <div
                                class="border-2 border-foreground rounded-md overflow-hidden bg-background odd:aspect-[3/4] even:aspect-square"
                                data-gallery-card
                                data-full="{{ card_image | image_url: width: 1600 }}"
                                {% if pass == 1 %}
                                  {{ block.shopify_attributes }}
                                {% endif %}
                              >
                                {% if card_image %}
                                  {{
                                    card_image
                                    | image_url: width: 800
                                    | image_tag:
                                      class: 'block w-full h-full object-cover',
                                      loading: 'lazy',
                                      sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 40vw, 80vw'
                                  }}
                                {% else %}
                                  <div class="w-full h-full bg-muted"></div>
                                {% endif %}
                              </div>
                            {% endif %}
                            {% assign idx = idx | plus: 1 %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {% comment %} FAQ section {% endcomment %}
      <div class="border-t-2 border-foreground mt-12"></div>
      <div id="faq" class="pt-12 scroll-mt-28 md:scroll-mt-32">
        {% liquid
          assign faq_count = 0
          for block in section.blocks
            if block.type == 'question'
              assign faq_count = faq_count | plus: 1
            endif
          endfor
          assign faq_visible = section.settings.faq_visible_count | default: 3
        %}

        {% if faq_count > 0 %}
          <style>
            #faq .faq-list--collapsed .faq-item:nth-child(n + {{ faq_visible | plus: 1 }}) {
              display: none;
            }
          </style>
          <div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 md:items-start">
            <div class="md:col-span-2 text-center md:text-left md:sticky md:top-8">
              {% render 'badge', text: section.settings.faq_badge %}

              {% if section.settings.faq_heading != blank %}
                <h2 class="font-primary m-0 text-[clamp(2rem,5vw,3rem)] font-bold leading-[1.05] uppercase text-foreground">
                  {{ section.settings.faq_heading }}
                </h2>
              {% endif %}

              {% if section.settings.faq_description != blank %}
                <div class="mt-4 text-base leading-relaxed text-accent max-w-[52ch] mx-auto md:mx-0 [&_p]:m-0">
                  {{ section.settings.faq_description }}
                </div>
              {% endif %}
            </div>

            <div class="md:col-span-3 w-full min-w-0">
              <div
                class="flex flex-col gap-[0.9rem] {% if faq_count > faq_visible %}faq-list--collapsed [mask-image:linear-gradient(to_bottom,black_55%,transparent_98%)] [-webkit-mask-image:linear-gradient(to_bottom,black_55%,transparent_98%)]{% endif %}"
                data-faq-list
              >
            {% for block in section.blocks %}
              {% if block.type == 'question' %}
                <div
                  class="faq-item border-2 border-foreground rounded-md bg-background overflow-hidden transition-shadow duration-200 {% if section.settings.faq_open_by_default %}faq-item--open{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <button
                    type="button"
                    class="flex items-center justify-between gap-4 w-full px-5 py-[1.1rem] max-sm:px-4 max-sm:py-[0.9rem] bg-transparent border-0 cursor-pointer text-left text-foreground"
                    aria-expanded="{{ section.settings.faq_open_by_default }}"
                    data-faq-trigger
                  >
                    <span class="m-0 text-base font-bold uppercase tracking-[0.01em] font-primary max-sm:text-[0.85rem]">{{ block.settings.question }}</span>
                    <span class="faq-item__icon shrink-0 w-8 h-8 rounded-full bg-accent text-white border-2 border-foreground inline-flex items-center justify-center transition-transform duration-300" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </span>
                  </button>
                  <div
                    class="px-5 pb-5 max-sm:px-4 max-sm:pb-4"
                    data-faq-panel
                    {% unless section.settings.faq_open_by_default %}
                      hidden
                    {% endunless %}
                  >
                    <p class="m-0 text-muted text-[0.95rem] leading-[1.6]">{{ block.settings.answer }}</p>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {% if faq_count > faq_visible %}
            <div class="text-center md:text-center mt-8">
              {% liquid
                assign cta_label = section.settings.faq_show_all_label
                assign cta_url = section.settings.faq_page_url
              %}
              <a
                href="{{ cta_url | default: '#' }}"
                data-magnetic
                class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 no-underline"
              >
                <span class="hover-rollup leading-[1.3] h-[1.3em]">
                  <span class="hover-rollup__item">{{ cta_label }}</span>
                  <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ cta_label }}</span>
                </span>
                <span class="inline-flex shrink-0" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </span>
              </a>
            </div>
          {% endif %}
            </div>
          </div>
        {% endif %}
          </div>
        </div>

        <dialog class="border-2 border-foreground rounded-xl p-0 max-w-[min(90vw,700px)] bg-background" data-gallery-lightbox aria-label="Drawing preview">
          <button type="button" class="absolute top-2 right-2 w-9 h-9 rounded-full border-2 border-foreground bg-accent text-white cursor-pointer inline-flex items-center justify-center" data-gallery-close aria-label="Close preview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
              <line x1="6" y1="6" x2="18" y2="18"/>
              <line x1="18" y1="6" x2="6" y2="18"/>
            </svg>
          </button>
        </dialog>
      </div>
</div>

{% stylesheet %}
  /* State hooks that can't be expressed with Tailwind alone.
     Layout is handled by Tailwind utilities in the markup above. */

  /* JS-toggled peek state (hover covered by group-hover: in markup) */
  .portfolio-folder.is-peeking .portfolio-folder__peek {
    transform: translateY(-90%);
  }

  .portfolio-folder:nth-child(even) .portfolio-folder__label {
    transform: rotate(1.5deg);
  }

  [data-gallery-lightbox]::backdrop {
    background: rgba(17, 17, 17, 0.6);
  }

  /* FAQ open state is toggled at runtime by JS (see below) */
  .faq-item--open {
    box-shadow: 4px 4px 0 var(--color-foreground);
  }

  .faq-item--open .faq-item__icon {
    transform: rotate(135deg);
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var frame = document.querySelector('[data-scroll-reveal]');
    if (!frame) return;

    var img = frame.querySelector('.scroll-reveal-img');
    if (!img) return;

    var ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(function () {
        var rect = frame.getBoundingClientRect();
        var vh = window.innerHeight;

        var start = vh * 0.7;
        var end = -rect.height * 0.3;
        var progress = (start - rect.top) / (start - end);
        progress = Math.max(0, Math.min(1, progress));

        img.style.objectPosition = 'center ' + (progress * 100) + '%';

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();

  (function () {
    var faq = document.getElementById('faq');
    if (!faq) return;

    faq.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-faq-trigger]');
      if (trigger) {
        var item = trigger.closest('.faq-item');
        var panel = item.querySelector('[data-faq-panel]');
        var isOpen = trigger.getAttribute('aria-expanded') === 'true';

        faq.querySelectorAll('[data-faq-trigger][aria-expanded="true"]').forEach(function (other) {
          if (other !== trigger) {
            other.setAttribute('aria-expanded', 'false');
            var otherItem = other.closest('.faq-item');
            otherItem.classList.remove('faq-item--open');
            otherItem.querySelector('[data-faq-panel]').hidden = true;
          }
        });

        trigger.setAttribute('aria-expanded', String(!isOpen));
        item.classList.toggle('faq-item--open', !isOpen);
        panel.hidden = isOpen;
      }
    });
  })();

  (function () {
    var folders = document.querySelector('[data-folders]');
    if (folders) {
      folders.addEventListener('click', function (event) {
        var folder = event.target.closest('[data-folder]');
        if (!folder) return;

        // Linked folder: first tap peeks, second tap follows the link (touch-friendly)
        if (folder.tagName === 'A' && !folder.classList.contains('is-peeking')) {
          if (window.matchMedia('(hover: none)').matches) {
            event.preventDefault();
            folder.classList.add('is-peeking');
            return;
          }
        }
        folder.classList.toggle('is-peeking');
      });

      folders.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        var folder = event.target.closest('[data-folder]');
        if (!folder || folder.tagName === 'A') return;
        event.preventDefault();
        folder.classList.toggle('is-peeking');
      });
    }

    var lightbox = document.querySelector('[data-gallery-lightbox]');

    /* The preview image is created on demand so no broken/empty <img>
       sits in the markup (and theme-check has no static img to flag). */
    function getLightboxImg() {
      if (!lightbox) return null;
      var img = lightbox.querySelector('[data-gallery-img]');
      if (!img) {
        img = document.createElement('img');
        img.setAttribute('data-gallery-img', '');
        img.alt = '';
        img.className = 'block w-full h-auto max-h-[80vh] object-contain';
        lightbox.insertBefore(img, lightbox.firstChild);
      }
      return img;
    }

    function openLightbox(src) {
      if (!lightbox || typeof lightbox.showModal !== 'function') return;
      var img = getLightboxImg();
      if (img) img.src = src;
      if (!lightbox.open) lightbox.showModal();
      if (window.gsap && window.ArthehopeAnims && !window.ArthehopeAnims.prefersReduced() && img) {
        window.gsap.from(img, { scale: 0.9, autoAlpha: 0, duration: 0.35, ease: 'back.out(1.5)', clearProps: 'all' });
      }
    }

    if (lightbox) {
      document.addEventListener('click', function (event) {
        var card = event.target.closest('[data-gallery-card]');
        if (card && card.dataset.full) {
          openLightbox(card.dataset.full);
          return;
        }
        if (event.target.closest('[data-gallery-close]')) lightbox.close();
      });

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        var card = event.target.closest && event.target.closest('[data-gallery-card]');
        if (card && card.dataset.full) {
          event.preventDefault();
          openLightbox(card.dataset.full);
        }
      });

      lightbox.addEventListener('click', function (event) {
        if (event.target === lightbox) lightbox.close();
      });
    }
  })();

  (function () {
    function init() {
      var helpers = window.ArthehopeAnims;
      if (!window.gsap) return;

      if (helpers.prefersReduced()) return;

      var hasST = !!window.ScrollTrigger;
      if (hasST) window.gsap.registerPlugin(window.ScrollTrigger);

      function scrollProps(trigger, extra) {
        var props = { trigger: trigger, start: 'top 82%' };
        if (extra) {
          for (var k in extra) props[k] = extra[k];
        }
        return props;
      }

      /* ---------- About ---------- */
      var about = document.getElementById('about');
      if (about && hasST) {
        var aboutWords = helpers.splitWords(about.querySelector('h2'));
        var aboutTl = window.gsap.timeline({
          scrollTrigger: scrollProps(about)
        });

        var aboutBadge = about.querySelector('.about-badge');
        if (aboutBadge) {
          aboutTl.from(aboutBadge, { scale: 0, rotation: -10, duration: 0.5, ease: 'back.out(1.7)' });
        }
        if (aboutWords.length) {
          aboutTl.from(aboutWords, { yPercent: 110, duration: 0.6, stagger: 0.07, ease: 'power3.out' }, '-=0.25');
        }
        var aboutDesc = about.querySelector('.text-accent');
        if (aboutDesc) aboutTl.from(aboutDesc, { y: 24, autoAlpha: 0, duration: 0.5 }, '-=0.35');
        var aboutCta = about.querySelector('[data-magnetic]');
        if (aboutCta) {
          aboutTl.from(aboutCta, { scale: 0, duration: 0.5, ease: 'back.out(1.7)' }, '-=0.3');
        }


        var frame = about.querySelector('[data-scroll-reveal]');
        if (frame) {
          window.gsap.from(frame, {
            x: 60,
            rotation: 3,
            autoAlpha: 0,
            duration: 0.8,
            ease: 'power3.out',
            clearProps: 'all',
            scrollTrigger: scrollProps(frame, { start: 'top 78%' })
          });
        }
      }



      /* ---------- Portfolio ---------- */
      var portfolio = document.getElementById('portfolio');
      if (portfolio && hasST) {
        var pfWords = helpers.splitWords(portfolio.querySelector('h2'));
        if (pfWords.length) {
          window.gsap.from(pfWords, {
            yPercent: 110,
            duration: 0.6,
            stagger: 0.07,
            ease: 'power3.out',
            scrollTrigger: scrollProps(portfolio)
          });
        }

        window.ScrollTrigger.batch('[data-folder]', {
          start: 'top 90%',
          once: true,
          onEnter: function (els) {
            window.gsap.fromTo(
              els,
              { y: 70, autoAlpha: 0, rotation: function () { return window.gsap.utils.random(-8, 8); } },
              {
                y: 0,
                autoAlpha: 1,
                rotation: 0,
                duration: 0.7,
                ease: 'back.out(1.4)',
                stagger: 0.1,
                clearProps: 'transform,opacity,visibility'
              }
            );
          }
        });
      }

      /* Folder wiggle on hover (fine pointers only). */
      if (window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll('[data-folder]').forEach(function (folder) {
          folder.addEventListener('mouseenter', function () {
            window.gsap.fromTo(
              folder,
              { rotation: -2 },
              { rotation: 2, duration: 0.07, repeat: 3, yoyo: true, clearProps: 'rotation', overwrite: 'auto' }
            );
          });
        });
      }

      /* ---------- Gallery ---------- */
      var gallery = document.getElementById('gallery');
      if (gallery && hasST) {
        var gWords = helpers.splitWords(gallery.querySelector('h2'));
        if (gWords.length) {
          window.gsap.from(gWords, {
            yPercent: 110,
            duration: 0.6,
            stagger: 0.07,
            ease: 'power3.out',
            scrollTrigger: scrollProps(gallery)
          });
        }

        var viewport = gallery.querySelector('[data-gallery-viewport]');
        if (viewport) {
          window.gsap.from(viewport, {
            y: 60,
            autoAlpha: 0,
            duration: 0.8,
            ease: 'power3.out',
            clearProps: 'all',
            scrollTrigger: scrollProps(viewport, { start: 'top 80%' })
          });
        }
      }

      /* ---------- FAQ ---------- */
      var faq = document.getElementById('faq');
      if (faq && hasST) {
        window.ScrollTrigger.batch('#faq .faq-item', {
          start: 'top 90%',
          once: true,
          onEnter: function (els) {
            window.gsap.fromTo(
              els,
              { y: 40, autoAlpha: 0 },
              { y: 0, autoAlpha: 1, duration: 0.55, ease: 'power3.out', stagger: 0.1, clearProps: 'transform,opacity,visibility' }
            );
          }
        });
      }


    }

    if (window.ArthehopeAnims) {
      window.ArthehopeAnims.whenGsap(init);
    }
  })();
{% endjavascript %}

