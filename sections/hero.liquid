<div
  class="full-width w-full mt-6 overflow-hidden"
  data-hero
>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:pt-0 md:pt-10 pt-20 items-center max-w-[1400px] mx-auto px-6 gap-0 overflow-x-hidden">
    <div class="relative z-0 flex items-center justify-center md:justify-end ">
      <div class="relative card-bg-hero border-2 border-foreground rounded-md p-8 md:p-10 max-w-[520px] card-shadow">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h1 data-hero-heading class="font-primary m-0 text-[clamp(2.25rem,6vw,3.5rem)] font-bold leading-[1.05] uppercase">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div data-hero-desc class="mt-4 text-base leading-relaxed text-accent [&_p]:m-0">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank or section.settings.dance_button_label != blank %}
          <div class="flex flex-wrap items-center gap-3 mt-2">
          {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_url | default: '/#gallery' }}"
            data-magnetic
            class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 no-underline"
          >
            <span class="hover-rollup leading-[1.3] h-[1.3em]">
              <span class="hover-rollup__item">{{ section.settings.button_label }}</span>
              <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ section.settings.button_label }}</span>
            </span>
            <span class="inline-flex shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
          {% endif %}

          {% if section.settings.dance_button_label != blank %}
            <button
              type="button"
              data-hero-dance
              data-magnetic
              aria-pressed="false"
              aria-busy="false"
              data-dance-start-label="{{ section.settings.dance_button_label | escape }}"
              data-dance-stop-label="{{ section.settings.dance_button_stop_label | escape }}"
              data-dance-loading-label="{{ 'sections.hero.dance_starting' | t | escape }}"
              class="font-primary hero-dance inline-flex items-center gap-2 rounded-md border-2 border-foreground bg-accent text-white font-bold uppercase text-sm px-5 py-3 cursor-pointer aria-pressed:bg-foreground aria-pressed:text-white disabled:cursor-wait disabled:opacity-70"
            >
              <svg
                class="hero-dance__spinner w-4 h-4 animate-spin"
                data-hero-dance-loader
                hidden
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10" stroke-opacity="0.3"/>
                <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
              </svg>
              <span class="hover-rollup leading-[1.3] h-[1.3em]" data-hero-dance-label>
                <span class="hover-rollup__item">{{ section.settings.dance_button_label | escape }}</span>
                <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ section.settings.dance_button_label | escape }}</span>
              </span>
            </button>
          {% endif %}
          </div>

          <p data-hero-dance-error hidden class="m-0 mt-3 text-sm text-accent">
            {{ 'sections.hero.dance_error' | t }}
          </p>
        {% endif %}

        {% if section.settings.show_rating %}
          <div data-hero-rating class="flex flex-col md:flex-row items-start md:items-center flex-wrap gap-x-3 gap-y-2 mt-6">
            <div class="flex gap-0.5 text-[#F5A623]" data-hero-stars aria-hidden="true">
              {% for i in (1..5) %}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7L2 9.2l7.1-.6z" />
                </svg>
              {% endfor %}
            </div>

            {% if section.settings.rating_text != blank %}
              <div class="text-sm text-foreground [&_p]:m-0">
                {{ section.settings.rating_text }}
              </div>
            {% endif %}
          </div>

          {% if section.blocks.size > 0 %}
            <div class="flex mt-3" data-hero-avatars>
              {% content_for 'blocks' %}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <!-- Tablet and above hero avatar (live VRM) - inside grid -->
    <div class="relative z-0 hidden md:flex justify-center md:mt-0 md:-ml-16" data-hero-media>
      <div class="w-full aspect-[3/4] lg:aspect-auto lg:h-[760px] lg:w-[570px] overflow-hidden relative" data-hero-vrm-slot="desktop">
        <!-- Placeholder image while VRM loads -->
        <img
          src="{{ 'loader.png' | asset_url }}"
          alt="Loading avatar"
          class="w-full h-full object-contain mt-4 lg:mt-6 absolute inset-0 transition-opacity duration-500"
          data-hero-vrm-skeleton
        />
        <canvas
          class="block w-full h-full hidden relative z-10"
          data-hero-vrm-canvas
          data-model-url="{{ 'lily.vrm' | asset_url }}"
        ></canvas>
      </div>
    </div>
  </div>
    <!-- Mobile hero avatar (live VRM) - outside grid to avoid overflow clipping -->
  <div class="relative z-0 -mt-48 h-[440px] md:hidden w-full -right-14 overflow-hidden pointer-events-none" data-hero-media>
    <div class="absolute inset-0 " data-hero-vrm-slot="mobile">
      <!-- Mobile placeholder image while VRM loads -->
      <img
        src="{{ 'loader.png' | asset_url }}"
        alt="Loading avatar"
        class="w-full h-full object-contain transition-opacity duration-500 scale-75 origin-bottom translate-y-1"
        data-hero-vrm-skeleton-mobile
      />
    </div>
  </div>

  {% if section.settings.marquee_text != blank %}
    <div class="full-width relative z-10 overflow-hidden bg-accent border-t-2 border-b-2 border-foreground" aria-hidden="true">
      <div class="flex items-center gap-8 whitespace-nowrap py-3 font-primary font-bold uppercase text-lg w-max animate-hero-marquee motion-reduce:animate-none">
        {% for i in (1..12) %}
          <div class="flex items-center gap-10 shrink-0 text-white">
            {% for j in (1..1) %}
              <span>{{ section.settings.marquee_text }}</span>
              <span aria-hidden="true">&#10022;</span>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  /* Dance button: keep accent bg while busy so it never flashes white,
     and guarantee the spinner shows regardless of Tailwind build state. */
  .hero-dance[disabled] {
    background-color: var(--color-accent);
    color: #fff;
    cursor: wait;
  }

  .hero-dance__spinner[hidden] {
    display: none;
  }

  .hero-dance.is-loading .hero-dance__spinner:not([hidden]) {
    display: inline-block;
  }

  .hero-dance.is-loading > [data-hero-dance-label] {
    opacity: 0.9;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function init() {
      var helpers = window.ArthehopeAnims;
      var hero = document.querySelector('[data-hero]');
      if (!hero || !window.gsap) return;

      if (helpers.prefersReduced()) return;

      var words = helpers.splitWords(hero.querySelector('[data-hero-heading]'));
      var stars = hero.querySelectorAll('[data-hero-stars] svg');
      var mediaElements = hero.querySelectorAll('[data-hero-media]');
      var media = mediaElements.length > 0 ? mediaElements[mediaElements.length - 1] : null;
      var mediaImg = media ? media.querySelector('img') : null;

      var tl = window.gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.from(hero.querySelector('.about-badge'), {
        scale: 0,
        rotation: -12,
        duration: 0.6,
        ease: 'back.out(1.7)'
      });

      if (words.length) {
        tl.from(words, { yPercent: 110, duration: 0.7, stagger: 0.08 }, '-=0.3');
      }

      tl.from(hero.querySelector('[data-hero-desc]'), { y: 24, autoAlpha: 0, duration: 0.6 }, '-=0.4');

      tl.from(hero.querySelectorAll('[data-magnetic]'), {
        scale: 0,
        duration: 0.6,
        ease: 'back.out(1.7)',
        stagger: 0.1
      }, '-=0.35');

      if (stars.length) {
        tl.from(stars, { scale: 0, transformOrigin: 'center', duration: 0.4, ease: 'back.out(2)', stagger: 0.07 }, '-=0.4');
      }

      var ratingText = hero.querySelector('[data-hero-rating] .text-sm');
      if (ratingText) tl.from(ratingText, { x: -12, autoAlpha: 0, duration: 0.4 }, '-=0.3');

      var avatars = hero.querySelectorAll('[data-hero-avatars] > *');
      if (avatars.length) {
        tl.from(avatars, { scale: 0, transformOrigin: 'center', duration: 0.4, ease: 'back.out(1.7)', stagger: 0.08 }, '-=0.4');
      }

      // Disabled: VRM media animation
      // mediaElements.forEach(function(mediaEl) {
      //   if (mediaEl) {
      //     tl.from(mediaEl, { clipPath: 'inset(0 0 100% 0)', duration: 0.9, ease: 'power4.out' }, 0.1);
      //     var img = mediaEl.querySelector('img');
      //     if (img) tl.from(img, { scale: 1.25, duration: 1.1, ease: 'power3.out' }, 0.1);
      //   }
      // });

      // Disabled: Parallax scroll animation for media
      // if (window.ScrollTrigger) {
      //   window.gsap.registerPlugin(window.ScrollTrigger);
      //   if (media) {
      //     window.gsap.to(media, {
      //       yPercent: 8,
      //       ease: 'none',
      //       scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true }
      //     });
      //   }
      // }
    }

    if (window.ArthehopeAnims) {
      window.ArthehopeAnims.whenGsap(init);
    }
  })();
{% endjavascript %}

<script type="module">
  import { createAvatarRuntime } from '{{ 'avatar-runtime.js' | asset_url }}';

  /* Hero avatar: lily.vrm renders by default in the same spot/footprint as
     the old image (framed from the waist up). "Let's Dance" starts the
     hidden camera + face/body trackers so the avatar mirrors you — the
     camera feed itself is never displayed. */
  function initHeroAvatar() {
    const hero = document.querySelector('[data-hero]');
    if (!hero || hero._heroAvatarInit) return;

    const deskSlot = hero.querySelector('[data-hero-vrm-slot="desktop"]');
    const mobSlot = hero.querySelector('[data-hero-vrm-slot="mobile"]');
    const canvas = hero.querySelector('[data-hero-vrm-canvas]');
    const danceBtn = hero.querySelector('[data-hero-dance]');
    const danceErr = hero.querySelector('[data-hero-dance-error]');
    const desktopSkeleton = hero.querySelector('[data-hero-vrm-skeleton]');
    const mobileSkeleton = hero.querySelector('[data-hero-vrm-skeleton-mobile]');
    if (!deskSlot || !mobSlot || !canvas || !danceBtn) return;
    hero._heroAvatarInit = true;

    const mqDesktop = window.matchMedia('(min-width: 768px)');

    const runtime = createAvatarRuntime({
      canvas,
      modelUrl: canvas.dataset.modelUrl,
      frameUpperBody: true,
      /* The mobile slot tucks up behind the card — keep the same headroom
         the old image had so the avatar never covers the buttons. */
      frameTopPad: mqDesktop.matches ? 0.02 : 0.1,
      dance: true,
      armSpread: 0.5,
      onReady: () => {
        // Fade out skeleton and show canvas when model is loaded
        const slot = mqDesktop.matches ? deskSlot : mobSlot;
        const skeleton = slot === deskSlot ? desktopSkeleton : mobileSkeleton;
        if (skeleton) skeleton.style.opacity = '0';
        canvas.classList.remove('hidden');
      }
    });

    /* One canvas, two responsive slots — move it with the breakpoint so
       tablet/desktop and mobile keep their exact image positions. */
    const place = () => {
      const isMobile = !mqDesktop.matches;
      const slot = isMobile ? mobSlot : deskSlot;
      if (canvas.parentElement !== slot) {
        // Adjust canvas positioning for mobile vs desktop
        if (isMobile) {
          canvas.style.position = 'absolute';
          canvas.style.inset = '0';
          canvas.style.width = '100%';
          canvas.style.height = '100%';
        } else {
          canvas.style.position = '';
          canvas.style.inset = '';
          canvas.style.width = '';
          canvas.style.height = '';
        }
        slot.appendChild(canvas);
      }
    };
    if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', place);
    else if (mqDesktop.addListener) mqDesktop.addListener(place);
    place();

    // Temporary debug: log initialization
    console.log('Hero Avatar Init:', { deskSlot, mobSlot, canvas, isMobile: !mqDesktop.matches });

    const startLabel = danceBtn.dataset.danceStartLabel || "Let's Dance";
    const stopLabel = danceBtn.dataset.danceStopLabel || "Stop Dance";
    const loadingLabel = danceBtn.dataset.danceLoadingLabel || 'Starting…';
    const danceLoader = hero.querySelector('[data-hero-dance-loader]');
    const danceLabelWrap = hero.querySelector('[data-hero-dance-label]');

    const updateDanceButtonText = (newLabel) => {
      const rollupItems = danceBtn.querySelectorAll('.hover-rollup__item');
      if (rollupItems.length >= 2) {
        rollupItems[0].textContent = newLabel;
        rollupItems[1].textContent = newLabel;
      }
    };

    const setLoading = (on) => {
      danceBtn.disabled = on;
      danceBtn.setAttribute('aria-busy', on ? 'true' : 'false');
      danceBtn.classList.toggle('is-loading', on);
      if (danceLoader) danceLoader.hidden = !on;
      updateDanceButtonText(on ? loadingLabel : (danceBtn.getAttribute('aria-pressed') === 'true' ? stopLabel : startLabel));
    };

    const setDance = (on) => {
      danceBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      updateDanceButtonText(on ? stopLabel : startLabel);
    };

    danceBtn.addEventListener('click', async () => {
      if (danceBtn.disabled || danceBtn.getAttribute('aria-busy') === 'true') return;
      if (runtime.active) {
        runtime.stop();
        setDance(false);
        return;
      }
      setLoading(true);
      if (danceErr) danceErr.setAttribute('hidden', '');
      const ok = await runtime.start();
      setLoading(false);
      setDance(!!ok);
      if (!ok && danceErr) danceErr.removeAttribute('hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAvatar, { once: true });
  } else {
    initHeroAvatar();
  }
  document.addEventListener('page:loaded', initHeroAvatar);
</script>

{% schema %}
{
  "name": "t:general.hero",
  "blocks": [{ "type": "avatar" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (used when no image is picked above)",
      "default": "https://cdn.shopify.com/s/files/1/0727/6055/7738/files/image01.png"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:labels.eyebrow_text",
      "default": "Hey hey there!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "I'm Your Artis"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>I draw cute things, cool characters, and all the little ideas you can't get out of your head.Got something in mind? Let's turn it into an illustration you'll love.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "See My Arts"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "text",
      "id": "dance_button_label",
      "label": "Dance button label",
      "default": "Let's Dance"
    },
    {
      "type": "text",
      "id": "dance_button_stop_label",
      "label": "Dance button stop label",
      "default": "Stop Dance"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:labels.show_rating",
      "default": true
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "t:labels.rating_text",
      "default": "<p>Loved by <strong>100+</strong> happy clients</p>"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "t:labels.marquee_text",
      "default": "WELCOME TO MY LITTLE CORNER!"
    }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
