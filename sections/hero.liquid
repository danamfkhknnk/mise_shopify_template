{% liquid
  assign hero_entry = metaobjects.hero.values | first
  assign hero_image = section.settings.image | default: hero_entry.image
%}

<div
  class="full-width w-full"
  data-hero
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:pt-0 md:pt-10 pt-20 items-center max-w-[1400px] mx-auto px-6 gap-0">
    <div class="relative z-0 flex items-center justify-center md:justify-end">
      <div class="relative card-bg-hero border-2 border-foreground rounded-md p-8 md:p-10 max-w-[520px] card-shadow">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h1 data-hero-heading class="font-primary m-0 text-[clamp(2.25rem,6vw,3.5rem)] font-bold leading-[1.05] uppercase">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div data-hero-desc class="mt-4 text-base leading-relaxed text-accent [&_p]:m-0">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_url | default: '/#gallery' }}"
            data-magnetic
            class="font-primary inline-flex items-center gap-2.5 rounded-md border-2 border-foreground bg-[var(--color-accent)] text-white font-bold uppercase text-sm px-5 py-3 mt-6 no-underline"
          >
            <span class="hover-rollup leading-[1.3] h-[1.3em]">
              <span class="hover-rollup__item">{{ section.settings.button_label }}</span>
              <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ section.settings.button_label }}</span>
            </span>
            <span class="inline-flex shrink-0" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </a>
        {% endif %}

        {% if section.settings.show_rating %}
          <div data-hero-rating class="flex items-center flex-wrap gap-x-3 gap-y-2 mt-6">
            <div class="flex gap-0.5 text-[#F5A623]" data-hero-stars aria-hidden="true">
              {% for i in (1..5) %}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7L2 9.2l7.1-.6z" />
                </svg>
              {% endfor %}
            </div>

            {% if section.settings.rating_text != blank %}
              <div class="text-sm text-foreground [&_p]:m-0">
                {{ section.settings.rating_text }}
              </div>
            {% endif %}
          </div>

          {% if section.blocks.size > 0 %}
            <div class="flex mt-3" data-hero-avatars>
              {% content_for 'blocks' %}
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="relative z-0 -mt-32 md:mt-0 md:-ml-16" data-hero-media>
      {% if hero_image %}
        {{
          hero_image
          | image_url: width: 1400
          | image_tag:
            class: 'w-full h-auto lg:h-[760px] object-cover object-top',
            loading: 'eager',
            sizes: '(min-width: 1024px) 50vw, 100vw'
        }}
      {% elsif section.settings.image_url != blank %}
        <img
          src="{{ section.settings.image_url }}"
          alt="{{ section.settings.heading | escape }}"
          class="w-full h-auto lg:h-[760px] object-cover object-top"
          loading="eager"
          sizes="(min-width: 1024px) 50vw, 100vw"
        >
      {% else %}
        <div class="w-full h-[320px] lg:h-[760px] bg-muted"></div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.marquee_text != blank %}
    <div class="full-width relative z-10 overflow-hidden mt-2 bg-accent border-t-2 border-b-2 border-foreground" aria-hidden="true">
      <div class="flex items-center gap-8 whitespace-nowrap py-3 font-primary font-bold uppercase text-lg w-max animate-hero-marquee motion-reduce:animate-none">
        {% for i in (1..12) %}
          <div class="flex items-center gap-10 shrink-0 text-white">
            {% for j in (1..1) %}
              <span>{{ section.settings.marquee_text }}</span>
              <span aria-hidden="true">&#10022;</span>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% javascript %}
  (function () {
    function init() {
      var helpers = window.ArthehopeAnims;
      var hero = document.querySelector('[data-hero]');
      if (!hero || !window.gsap) return;

      if (helpers.prefersReduced()) return;

      var words = helpers.splitWords(hero.querySelector('[data-hero-heading]'));
      var stars = hero.querySelectorAll('[data-hero-stars] svg');
      var media = hero.querySelector('[data-hero-media]');
      var mediaImg = media ? media.querySelector('img') : null;

      var tl = window.gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.from(hero.querySelector('.about-badge'), {
        scale: 0,
        rotation: -12,
        duration: 0.6,
        ease: 'back.out(1.7)'
      });

      if (words.length) {
        tl.from(words, { yPercent: 110, duration: 0.7, stagger: 0.08 }, '-=0.3');
      }

      tl.from(hero.querySelector('[data-hero-desc]'), { y: 24, autoAlpha: 0, duration: 0.6 }, '-=0.4');

      tl.from(hero.querySelector('[data-magnetic]'), {
        scale: 0,
        duration: 0.6,
        ease: 'back.out(1.7)'
      }, '-=0.35');

      if (stars.length) {
        tl.from(stars, { scale: 0, transformOrigin: 'center', duration: 0.4, ease: 'back.out(2)', stagger: 0.07 }, '-=0.4');
      }

      var ratingText = hero.querySelector('[data-hero-rating] .text-sm');
      if (ratingText) tl.from(ratingText, { x: -12, autoAlpha: 0, duration: 0.4 }, '-=0.3');

      var avatars = hero.querySelectorAll('[data-hero-avatars] > *');
      if (avatars.length) {
        tl.from(avatars, { scale: 0, transformOrigin: 'center', duration: 0.4, ease: 'back.out(1.7)', stagger: 0.08 }, '-=0.4');
      }

      if (media) {
        tl.from(media, { clipPath: 'inset(0 0 100% 0)', duration: 0.9, ease: 'power4.out' }, 0.1);
        if (mediaImg) tl.from(mediaImg, { scale: 1.25, duration: 1.1, ease: 'power3.out' }, 0.1);
      }

      if (window.ScrollTrigger) {
        window.gsap.registerPlugin(window.ScrollTrigger);
        if (media) {
          window.gsap.to(media, {
            yPercent: 8,
            ease: 'none',
            scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true }
          });
        }
      }
    }

    if (window.ArthehopeAnims) {
      window.ArthehopeAnims.whenGsap(init);
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero",
  "blocks": [{ "type": "avatar" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (used when no image is picked above)",
      "default": "https://cdn.shopify.com/s/files/1/0727/6055/7738/files/image01.png"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:labels.eyebrow_text",
      "default": "Hey hey there!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "I'm Your Artis"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>I draw cute things, cool characters, and all the little ideas you can't get out of your head.Got something in mind? Let's turn it into an illustration you'll love.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "See My Arts"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:labels.show_rating",
      "default": true
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "t:labels.rating_text",
      "default": "<p>Loved by <strong>100+</strong> happy clients</p>"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "t:labels.marquee_text",
      "default": "WELCOME TO MY LITTLE CORNER!"
    }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
