{% doc %}
  Renders a full FAQ page with a badge, heading, description and an
  accordion list of "question" blocks.

  @example
  {% section 'faq' %}
{% enddoc %}

<div class="full-width w-full">
  <div class="max-w-[1400px] mx-auto px-6 py-16 md:py-24">
    <div class="bg-white border-2 border-foreground rounded-md p-8 md:p-12">

      <div class="text-center mb-12 md:mb-16">
        {% render 'badge', text: section.settings.badge_text %}

        {% if section.settings.heading != blank %}
          <h1 class="font-primary m-0 text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.05] uppercase mt-4">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="mt-4 text-base leading-relaxed text-accent max-w-[52ch] mx-auto [&_p]:m-0">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="max-w-[720px] mx-auto flex flex-col gap-[0.9rem]" data-faq-list>
        {% content_for 'blocks' %}
      </div>

    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('click', function (event) {
    var trigger = event.target.closest('[data-faq-trigger]');
    if (!trigger) return;

    var list = trigger.closest('[data-faq-list]');
    if (!list) return;

    var item = trigger.parentElement;
    var panel = item.querySelector('[data-faq-panel]');
    var icon = trigger.querySelector('[data-faq-icon]');
    if (!panel) return;

    var isOpen = trigger.getAttribute('aria-expanded') === 'true';

    list.querySelectorAll('[data-faq-trigger][aria-expanded="true"]').forEach(function (other) {
      if (other === trigger) return;
      other.setAttribute('aria-expanded', 'false');
      var otherItem = other.parentElement;
      var otherPanel = otherItem.querySelector('[data-faq-panel]');
      var otherIcon = other.querySelector('[data-faq-icon]');
      if (otherPanel) otherPanel.hidden = true;
      if (otherIcon) otherIcon.style.transform = '';
      otherItem.classList.remove('shadow-hard');
    });

    trigger.setAttribute('aria-expanded', String(!isOpen));
    panel.hidden = isOpen;
    item.classList.toggle('shadow-hard', !isOpen);
    if (icon) icon.style.transform = isOpen ? '' : 'rotate(135deg)';
  });
{% endjavascript %}

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "question"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Everything you need to know before reaching out.</p>"
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long does a commission take?",
            "answer": "Turnaround usually takes 1-3 weeks depending on complexity and current queue length. You'll get updates along the way."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "All major cards and PayPal are accepted at checkout, processed securely through Shopify."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I request revisions?",
            "answer": "Yes, each commission includes a set number of revision rounds so the final piece matches your vision."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you offer commercial usage rights?",
            "answer": "Commercial licensing is available as an add-on. Reach out before ordering if you need it for a business or product."
          }
        }
      ]
    }
  ]
}
{% endschema %}
