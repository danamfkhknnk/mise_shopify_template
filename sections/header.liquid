<header class="fixed top-5 left-1/2 -translate-x-1/2 w-[calc(100%-40px)] max-w-[1400px] z-50" data-mobile-menu>
  <div class="flex items-center justify-between bg-white border-2 border-foreground rounded-pill px-8 py-3">
    <h2 class="text-base font-extrabold tracking-widest uppercase m-0 font-primary shrink-0">
      {{ shop.name | link_to: routes.root_url }}
    </h2>

    <nav class="hidden md:flex items-center gap-6">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="hover-rollup leading-[1.3] h-[1.3em] text-sm font-bold tracking-wider uppercase text-foreground no-underline font-primary">
          <span class="hover-rollup__item">{{ link.title }}</span>
          <span class="hover-rollup__item hover-rollup__item--clone" aria-hidden="true">{{ link.title }}</span>
        </a>
      {% endfor %}
    </nav>



    <div class="flex items-center gap-4 shrink-0">
      <a href="{{ routes.account_url }}" class="hover-rollup w-6 h-6 text-foreground [&_svg]:w-6 [&_svg]:h-6 [&_svg]:block">
        <span class="w-6 h-6 shrink-0 hover-rollup__item">
          {{ 'icon-account.svg' | inline_asset_content }}
        </span>
        <span class="w-6 h-6 shrink-0 hover-rollup__item hover-rollup__item--clone" aria-hidden="true">
          {{ 'icon-account.svg' | inline_asset_content }}
        </span>
      </a>

      {% if cart.item_count > 0 %}
        <span class="absolute top-3 right-[68px] md:right-7 text-foreground text-sm font-primary z-10 leading-none w-4 bg-accent rounded-full h-4 flex items-center justify-center" data-cart-count>
          {{ cart.item_count }}
        </span>
      {% endif %}
      <a href="{{ routes.cart_url }}" class="hover-rollup w-6 h-6 text-foreground relative [&_svg]:w-6 [&_svg]:h-6 [&_svg]:block">
        <span class="w-6 h-6 shrink-0 hover-rollup__item">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>
        <span class="w-6 h-6 shrink-0 hover-rollup__item hover-rollup__item--clone" aria-hidden="true">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>
      </a>

      <button
        type="button"
        class="flex flex-col justify-center items-center gap-[5px] w-6 h-6 p-0 bg-transparent border-0 cursor-pointer md:hidden text-foreground"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label="{{ 'header.menu' | t }}"
      >
        <span class="block w-full h-[2px] bg-current rounded transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"></span>
        <span class="block w-full h-[2px] bg-current rounded transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"></span>
        <span class="block w-full h-[2px] bg-current rounded transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"></span>
      </button>
    </div>
  </div>

  {% if section.settings.menu != blank %}
    <nav
      id="mobile-menu-panel"
      class="mobile-menu md:hidden"
      data-mobile-menu-panel
    >
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="py-3 px-4 rounded-pill hover:bg-background text-sm font-bold tracking-wider uppercase text-foreground no-underline font-primary">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>
  {% endif %}
</header>

{% stylesheet %}
  /* Section stylesheets load after tailwind.css, so `md:hidden` alone
     can't be trusted to win the cascade here; enforce it directly. */
  @media (min-width: 768px) {
    [data-mobile-menu-toggle] {
      display: none;
    }

    .mobile-menu {
      display: none;
    }
  }

  [data-mobile-menu].is-menu-open [data-mobile-menu-toggle] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  [data-mobile-menu].is-menu-open [data-mobile-menu-toggle] span:nth-child(2) {
    opacity: 0;
  }

  [data-mobile-menu].is-menu-open [data-mobile-menu-toggle] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile nav panel */
  .mobile-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    background: var(--color-background);
    border: 2px solid transparent;
    border-radius: 24px;
    padding: 0 8px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, padding 0.3s ease,
      border-color 0.3s ease;
  }

  [data-mobile-menu].is-menu-open .mobile-menu {
    max-height: 60vh;
    opacity: 1;
    pointer-events: auto;
    overflow-y: auto;
    padding: 12px 8px;
    border-color: var(--color-foreground);
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var header = document.querySelector('[data-mobile-menu]');
    if (!header) return;

    var toggle = header.querySelector('[data-mobile-menu-toggle]');
    var panel = header.querySelector('[data-mobile-menu-panel]');
    if (!toggle || !panel) return;

    function closeMenu() {
      header.classList.remove('is-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', function () {
      var isOpen = header.classList.toggle('is-menu-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    panel.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeMenu();
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', function (event) {
      if (event.matches) closeMenu();
    });
  })();

  (function () {
    function init() {
      var helpers = window.ArthehopeAnims;
      var header = document.querySelector('[data-mobile-menu]');
      if (!header || !window.gsap) return;

      if (helpers.prefersReduced()) return;

      /* Intro: pill drops in with a springy pop. */
      window.gsap.from(header, {
        y: -80,
        autoAlpha: 0,
        duration: 0.8,
        delay: 0.15,
        ease: 'back.out(1.4)',
        clearProps: 'all'
      });

      /* Hide on scroll down, reveal on scroll up + soft shadow when scrolled. */
      var lastY = window.scrollY;
      var hidden = false;
      var ticking = false;

      function update() {
        ticking = false;
        var y = window.scrollY;

        window.gsap.to(header, {
          duration: 0.3,
          overwrite: 'auto'
        });

        if (y > lastY && y > 220 && !header.classList.contains('is-menu-open')) {
          if (!hidden) {
            hidden = true;
            window.gsap.to(header, { yPercent: -180, autoAlpha: 0, duration: 0.35, ease: 'power2.in', overwrite: 'auto' });
          }
        } else if (y < lastY || y <= 220) {
          if (hidden) {
            hidden = false;
            window.gsap.to(header, { yPercent: 0, autoAlpha: 1, duration: 0.4, ease: 'power3.out', overwrite: 'auto' });
          }
        }
        lastY = y;
      }

      window.addEventListener(
        'scroll',
        function () {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
    }

    if (window.ArthehopeAnims) {
      window.ArthehopeAnims.whenGsap(init);
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
