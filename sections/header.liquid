<header class="fixed top-5 left-1/2 -translate-x-1/2 w-[calc(100%-40px)] max-w-[1400px] z-50">
  <div class="flex items-center justify-between bg-white border-2 border-black rounded-pill px-8 py-3">
    <h2 class="text-base font-extrabold tracking-widest uppercase m-0 font-primary shrink-0">
      {{ shop.name | link_to: routes.root_url }}
    </h2>

    <nav class="hidden md:flex items-center gap-6">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="nav-link text-sm font-bold tracking-wider uppercase text-black no-underline font-primary">
          <span class="nav-link__text">{{ link.title }}</span>
          <span class="nav-link__text nav-link__text--clone" aria-hidden="true">{{ link.title }}</span>
        </a>
      {% endfor %}
    </nav>



    <div class="flex items-center gap-4 shrink-0">
      <a href="{{ routes.account_url }}" class="icon-rollup text-black">
        <span class="icon-rollup__inner">
          {{ 'icon-account.svg' | inline_asset_content }}
        </span>
        <span class="icon-rollup__inner icon-rollup__clone" aria-hidden="true">
          {{ 'icon-account.svg' | inline_asset_content }}
        </span>
      </a>

      <a href="{{ routes.cart_url }}" class="icon-rollup text-black relative">
        {% if cart.item_count > 0 %}
          <span class="absolute -top-2 -right-2 bg-black text-white text-xs w-5 h-5 rounded-full flex items-center justify-center font-primary z-10">
            {{ cart.item_count }}
          </span>
        {% endif %}
        <span class="icon-rollup__inner">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>
        <span class="icon-rollup__inner icon-rollup__clone" aria-hidden="true">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .nav-link {
    display: inline-flex;
    flex-direction: column;
    overflow: hidden;
    line-height: 1.3;
    position: relative;
    height: 1.3em;
  }

  .nav-link__text {
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link__text--clone {
    position: absolute;
    top: 100%;
    left: 0;
  }

  .nav-link:hover .nav-link__text {
    transform: translateY(-100%);
  }

  /* Icon roll-up */
  .icon-rollup {
    display: inline-flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    width: 24px;
    height: 24px;
  }

  .icon-rollup__inner {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .icon-rollup__inner svg {
    width: 24px;
    height: 24px;
  }

  .icon-rollup__clone {
    position: absolute;
    top: 100%;
    left: 0;
  }

  .icon-rollup:hover .icon-rollup__inner {
    transform: translateY(-100%);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
