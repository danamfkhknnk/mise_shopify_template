<div
  {% if animate %}data-gs="test-card"{% endif %}
  class="watercolor-card p-6 flex flex-col justify-between relative shrink-0 w-[300px] sm:w-[340px] overflow-hidden"
  {% if shopify_attrs %}{{ block.shopify_attributes }}{% endif %}
>
  {% comment %} <div class="absolute top-0 right-0 w-24 h-24 opacity-30 pointer-events-none" style="background: radial-gradient(circle, rgba(196,114,127,0.15), transparent 70%); border-radius: 50%;"></div> {% endcomment %}
  <svg {% if animate %}data-gs="test-icon"{% endif %} class="w-10 h-10 mb-2" style="color: rgba(196,114,127,0.25);" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  </svg>
  <p class="text-body leading-relaxed mb-2 italic" style="color: var(--color-muted);">"{{ block.settings.quote }}"</p>
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background: rgba(196,114,127,0.08); border: 1px solid rgba(196,114,127,0.15);">
      <span class="text-body font-semibold" style="color: var(--color-blush);">{{ block.settings.author | truncate: 2, "" }}</span>
    </div>
    <div>
      <p class="text-body-sm font-medium" style="color: var(--color-foreground);">{{ block.settings.author }}</p>
      <div {% if animate %}data-gs="test-stars"{% endif %} class="flex items-center gap-1 mt-1">
        {% for i in (1..5) %}
          {% if i <= block.settings.rating %}
            <svg class="w-4 h-4" style="color: var(--color-golden);" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {% else %}
            <svg class="w-4 h-4" style="color: rgba(196,162,101,0.25);" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
