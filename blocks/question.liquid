{% doc %}
  Renders a single FAQ accordion item with a question trigger and
  a collapsible answer panel.

  @param {string} question - The FAQ question
  @param {string} [answer] - The FAQ answer

  @example
  {% content_for 'block', type: 'question', id: 'faq-1' %}
{% enddoc %}

<div
  class="border-2 border-foreground rounded-md bg-background overflow-hidden transition-shadow duration-200 {% if block.settings.open_by_default %}shadow-hard{% endif %}"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="flex items-center justify-between gap-4 w-full px-5 py-[1.1rem] max-sm:px-4 max-sm:py-[0.9rem] bg-transparent border-0 cursor-pointer text-left text-foreground"
    aria-expanded="{{ block.settings.open_by_default }}"
    data-faq-trigger
  >
    <span class="m-0 text-base font-bold uppercase tracking-[0.01em] font-primary max-sm:text-[0.85rem]">{{ block.settings.question }}</span>
    <span data-faq-icon class="shrink-0 w-8 h-8 rounded-full bg-accent text-white border-2 border-foreground inline-flex items-center justify-center transition-transform duration-300 {% if block.settings.open_by_default %}rotate-[135deg]{% endif %}" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </span>
  </button>
  <div
    class="px-5 pb-5 max-sm:px-4 max-sm:pb-4"
    data-faq-panel
    {% unless block.settings.open_by_default %}
      hidden
    {% endunless %}
  >
    <p class="m-0 text-muted text-[0.95rem] leading-[1.6]">{{ block.settings.answer }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Question",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "How long does a commission take?"
    },
    {
      "type": "textarea",
      "id": "answer",
      "label": "Answer",
      "default": "Turnaround usually takes 1-3 weeks depending on complexity and current queue length."
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open answer by default",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Question"
    }
  ]
}
{% endschema %}
