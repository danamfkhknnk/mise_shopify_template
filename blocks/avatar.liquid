{% doc %}
  Renders a single circular avatar used in the hero's stacked avatar row.

  @param {image} image - The avatar image

  @example
  {% content_for 'block', type: 'avatar', id: 'avatar-1' %}
{% enddoc %}

{% if image %}
  <div class="rounded-full border-2 border-white overflow-hidden w-9 h-9 -ml-2 first:ml-0">
    {{ image | image_url: width: 72 | image_tag: width: 36, height: 36, loading: 'lazy' }}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.avatar",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.avatar_image"
    }
  ],
  "presets": [{ "name": "t:general.avatar" }]
}
{% endschema %}
